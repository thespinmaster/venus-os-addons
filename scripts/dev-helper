#!/usr/bin/env bash
set -euo pipefail

readonly this_path="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
readonly usb_lib="$this_path/libs/usb-lib"
readonly dbus_common="/data/dev/addons/vespera/src/data/apps/vespera/libs/dbus-lib"
readonly serial_starter_rules="/etc/udev/rules.d/serial-starter.rules"
readonly serial_starter_conf="/etc/venus/serial-starter.conf"
readonly service_templates_dir="/opt/victronenergy/service-templates"


print_clear_all() {
  printf '\033c'
}

print_success() {
  echo "✓ $*"
}

print_info() {
  echo "ℹ $*"
}

print_error() {
  echo "✗ $*" >&2
}

normalize_service_name() {
  local value="${1,,}"
  value="${value//-/_}"
  value="${value// /_}"
  value="${value//./_}"
  printf '%s\n' "$value"
}

score_udev_rule_match() {
  local query_norm="$1"
  local ve_service="$2"
  local line="$3"
  local ve_norm line_norm token token_norm
  local -a ve_tokens=()

  ve_norm="$(normalize_service_name "$ve_service")"
  if [[ "$ve_norm" == "$query_norm" ]]; then
    printf '0\n'
    return 0
  fi

  IFS=':' read -r -a ve_tokens <<< "$ve_service"
  for token in "${ve_tokens[@]}"; do
    token_norm="$(normalize_service_name "$token")"
    if [[ "$token_norm" == "$query_norm" ]]; then
      printf '1\n'
      return 0
    fi
  done

  if [[ "$ve_norm" == *"$query_norm"* ]]; then
    printf '2\n'
    return 0
  fi

  line_norm="$(normalize_service_name "$line")"
  if [[ "$line_norm" == *"$query_norm"* ]]; then
    printf '3\n'
    return 0
  fi

  printf '99\n'
}

find_best_udev_rule() {
  local query="$1"
  local query_norm line ve_service score
  local best_score=99
  local match_count=0
  local best_line=""
  local best_service=""

  query_norm="$(normalize_service_name "$query")"

  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" == *'ENV{VE_SERVICE}'* ]] || continue

    ve_service="$(sed -n 's/.*ENV{VE_SERVICE}="\([^"]*\)".*/\1/p' <<< "$line")"
    [[ -n "$ve_service" ]] || continue

    score="$(score_udev_rule_match "$query_norm" "$ve_service" "$line")"
    if (( score < 99 )); then
      ((match_count += 1))
      if (( score < best_score )); then
        best_score=$score
        best_line="$line"
        best_service="$ve_service"
      fi
    fi
  done < "$serial_starter_rules"

  [[ -n "$best_line" ]] || return 1
  printf '%s\n%s\n%s\n' "$best_line" "$best_service" "$match_count"
}

check_service() {
  local requested_service="$1"
  local match_data rule_line ve_service conf_line alias_line lookup_name template_name template_dir run_script
  local match_count=1
  local -a match_parts=()

  [[ -r "$serial_starter_rules" ]] || { print_error "Missing rules file: $serial_starter_rules"; return 1; }
  [[ -r "$serial_starter_conf" ]] || { print_error "Missing config file: $serial_starter_conf"; return 1; }

  if ! match_data="$(find_best_udev_rule "$requested_service")"; then
    print_error "No VE_SERVICE rule matched '$requested_service' in $serial_starter_rules"
    return 1
  fi

  mapfile -t match_parts <<< "$match_data"
  rule_line="${match_parts[0]:-}"
  ve_service="${match_parts[1]:-}"
  match_count="${match_parts[2]:-1}"

  print_success "$rule_line"
  print_success "ENV{VE_SERVICE}=\"$ve_service\""
  if (( match_count > 1 )); then
    print_info "Matched $match_count udev rules; using the best match for '$requested_service'."
  fi

  lookup_name="${ve_service%%:*}"
  conf_line="$(grep -E "^[[:space:]]*service[[:space:]]+${lookup_name}([[:space:]]|$)" "$serial_starter_conf" | head -n 1 || true)"

  if [[ -z "$conf_line" ]]; then
    alias_line="$(grep -E "^[[:space:]]*alias[[:space:]]+${lookup_name}([[:space:]]|$)" "$serial_starter_conf" | head -n 1 || true)"
    if [[ -n "$alias_line" ]]; then
      print_success "$alias_line"
      lookup_name="$(awk '{print $3}' <<< "$alias_line")"
      lookup_name="${lookup_name%%:*}"
      conf_line="$(grep -E "^[[:space:]]*service[[:space:]]+${lookup_name}([[:space:]]|$)" "$serial_starter_conf" | head -n 1 || true)"
    fi
  fi

  [[ -n "$conf_line" ]] || { print_error "No matching service entry found in $serial_starter_conf for '$ve_service'"; return 1; }

  print_success "$conf_line"

  template_name="$(awk '{print $3}' <<< "$conf_line")"
  [[ -n "$template_name" ]] || { print_error "Could not extract a service-template name from: $conf_line"; return 1; }

  template_dir="$service_templates_dir/$template_name"
  if [[ -d "$template_dir" ]]; then
    print_success "$template_dir"
  else
    print_error "Missing service template: $template_dir"
    return 1
  fi

  run_script="$template_dir/run"
  if [[ -x "$run_script" ]]; then
    print_success "$run_script"
  elif [[ -e "$run_script" ]]; then
    print_info "Run script exists but is not executable: $run_script"
  else
    print_info "Run script is missing: $run_script"
  fi

  if [[ -e "$template_dir/down" ]]; then
    print_info "Template is currently disabled by a 'down' file."
  fi

  if [[ "$ve_service" == *:* ]]; then
    print_info "VE_SERVICE fallback chain detected: $ve_service"
  fi
}

print_help() {
  cat <<'EOF'
Dev helper commands:
  dev start
      Start the supplied service.
  dev restart
      Restart the supplied service.
  dev monitor gui
      Follow the GUI log.
  dev monitor service <serviceName>
      Follow the GUI log.
  dev usb reconnect <ttyUSB0>
      Reconnect a USB tty device using `scripts/libs/usb-lib`.
  dev usb remove|disconnect [ttyUSB0]
      Disconnects a usb device
  dev usb add|connect [1-1.4]
      Connects a previously disconnected USB device`scripts/libs/usb-lib`.
  dev usb list [ttyUSB0]
      Show `udevadm` properties for one tty, or all USB tty devices.
  dev udev reload
      reloads all the usb rules files (serial-starter-rules and others)
  dev udev add [tty port]
      uses udeadm to send an "add" trigger, simulating a device being added
  dev udev remove [tty port]
      uses udeadm to send an "remove" trigger, simulating a device being removed
  dev udev change [tty port]
      uses udeadm to send an "change" trigger, simulating a device change
  dev udev test [tty port]
      uses udeadm to output the test results from scanning the device rules files
  dev check service <name>
      Check the udev -> serial-starter -> service-template chain for a service.
  dev show diskspace
      Shows the available storage space.
  dev reset service <ttyUSB0> <service-name>
      Stop the tty-backed service, remove its `/service` entry, and clear serial-starter tty/lock files.
  dev shell shorten
      Print the prompt change command, or apply it directly when sourced.
  dev help
      Show this help.
EOF
}

dbus_run() {
  case "${1:-}" in
    delete-tree)
      [[ -n "${2:-}" ]] || { echo "ERROR: invalid path'" >&2; return 1; }
      "${dbus_common}" dbus-delete-tree "${2}"
      ;;

    *)
      echo "ERROR: Unknown dbus command: ${1:-<missing>}" >&2
      print_help >&2
      return 1
      ;;
  esac
}

run_monitor() {

  [[ -z "${1:-}" ]] && { echo "ERROR: Unknown monitor target" >&2; return 1; }

  local serviceName=${1#/service/}

  if [[ ! -f /var/log/${serviceName}/current ]]; then

    echo "ERROR: Unknown monitor target: ${1:-}" >&2
    return 1
  fi
  tail -F /var/log/${serviceName}/current | tai64nlocal
}

run_service() {
  local serviceArg=${1:-}
  shift
  if [[ -n "${1:-}" ]]; then
    local serviceName=${1#/service/}
    svc ${serviceArg} "/service/${serviceName}"
    [[ -n "${2:-}" ]] && {
      shift
      main "$@" "/service/${serviceName}"
    }
    return
  fi
  echo "ERROR: Unknown service: ${1:-<missing>}" >&2
  print_help >&2
  return 1
  [[ -z "${2}" ]]

}
run_restart() { run_service -t "$@"; }
run_start() { run_service -u "$@"; }
run_stop() { run_service -d "$@"; }

run_shell() {
  case "${1:-}" in
    shorten)
      if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
        PS1='\W# '
        export PS1
        return 0
      fi

      printf 'copy: %s\n' "PS1='\\W# '"
      ;;
    *)
      echo "ERROR: Unknown shell command: ${1:-<missing>}" >&2
      print_help >&2
      return 1
      ;;
  esac
}

run_usb() {
  case "${1:-}" in
    reconnect)
      [[ -n "${2:-}" ]] || { echo "ERROR: tty is required for 'dev usb reconnect'" >&2; return 1; }
      "${usb_lib}" reconnect "${2}"
      ;;
    remove|disconnect)
      [[ -n "${2:-}" ]] || { echo "ERROR: tty is required for 'dev usb disconnect'" >&2; return 1; }
      "${usb_lib}" disconnect "${2}"
      ;;
    add|connect)
      [[ -n "${2:-}" ]] || { echo "ERROR: device id (1-4:1) is required for 'dev usb connect'" >&2; return 1; }
      "${usb_lib}" connect "${2}"
      ;;
    list)
      "${usb_lib}" list "${2:-}"
      ;;
    *)
      echo "ERROR: Unknown usb command: ${1:-<missing>}" >&2
      print_help >&2
      return 1
      ;;
  esac
}

run_check() {
  case "${1:-}" in
    service)
      [[ -n "${2:-}" ]] || { print_error "service name is required for 'dev check service'"; return 1; }
      check_service "$2"
      ;;
    diskspace)
      df -h --total
      ;;
    *)
      print_error "Unknown check command: ${1:-<missing>}"
      print_help >&2
      return 1
      ;;
  esac
}

reset_service() {
  local tty="${1:-}"
  local service_name="${2:-}"
  local service_dir serial_path lock_path

  [[ -n "$tty" ]] || { print_error "tty is required for 'dev reset service'"; return 1; }
  [[ -n "$service_name" ]] || { print_error "service name is required for 'dev reset service'"; return 1; }

  service_dir="/service/${service_name}.${tty}"
  serial_path="/dev/serial-starter/${tty}"

  if [[ -e "$service_dir" || -L "$service_dir" ]]; then
    if svc -d "$service_dir"; then
      print_success "Stopped service: $service_dir"
    else
      print_info "Stop command returned non-zero for: $service_dir"
    fi

    rm -rf "$service_dir"
    print_success "Removed service dir: $service_dir"
  else
    print_info "Service dir already absent: $service_dir"
  fi

  if [[ -e "$serial_path" || -L "$serial_path" ]]; then
    rm -f "$serial_path"
    print_success "Removed serial-starter tty: $serial_path"
  else
    print_info "TTY file already absent: $serial_path"
  fi

  for lock_path in \
    "/var/lock/serial-starter/${tty}" \
    "/run/lock/serial-starter/${tty}"
  do
    if [[ -e "$lock_path" || -L "$lock_path" ]]; then
      rm -f "$lock_path"
      print_success "Removed lock file: $lock_path"
    fi
  done

  print_success "Reset complete for ${service_name}.${tty}"
}
run_udev() {
  case "${1:-}" in
    reload)
      udevadm control --reload
      [[ -n "${2:-}" ]] &&
        run_udev ${2:-} "${3:-}"
      ;;
    add|remove|change)
      [[ -z "${2:-}" ]] && echo "missing argument: tty port"
      udevadm trigger --action=${1} /sys/class/tty/${2}
      ;;
    test)
      [[ -z "${2:-}" ]] && echo "missing argument: tty port"
      udevadm test /sys/class/tty/${2}
      ;;
    *)
      print_error "Unknown udev command: ${1:-<missing>}"
      print_help >&2
      return 1
      ;;
  esac
}

run_reset() {
  case "${1:-}" in
    service)
      [[ -n "${2:-}" ]] || { print_error "tty is required for 'dev reset service'"; return 1; }
      [[ -n "${3:-}" ]] || { print_error "service name is required for 'dev reset service'"; return 1; }
      reset_service "$2" "$3"
      ;;
    *)
      print_error "Unknown reset command: ${1:-<missing>}"
      print_help >&2
      return 1
      ;;
  esac
}


main() {

  local command="${1:-help}"
  [[ -n "${1:-}" ]] && shift

  case "${command}" in
    paths)
      echo "$this_path"
      echo "$usb_lib"
      echo "$dbus_common"
      ;;
    udev)
      run_udev "$@"
      ;;
    cls|clear|clr)
      print_clear_all
      ;;
    help|--help|"")
      print_help
      ;;
    shell)
      run_shell "$@"
      ;;
    monitor)
      run_monitor "${1:-$(</dev/stdin)}"
      ;;
    start)
      run_start "$@"
      ;;
    stop)
      run_stop "$@"
      ;;
    restart)
      run_restart "$@"
      ;;
    dbus)
      dbus_run "$@"
      ;;
    usb)
      run_usb "$@"
      ;;
    check)
      run_check "$@"
      ;;
    reset)
      run_reset "$@"
      ;;
    *)
      echo "ERROR: Unknown command: ${command}" >&2
      print_help >&2
      return 1
      ;;
  esac
}

main "$@"
