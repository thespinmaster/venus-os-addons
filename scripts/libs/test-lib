#!/usr/bin/env bash

set -o nounset

EXIT_ON_FAILED_TEST=
TEST_INDENT=
TEST_RUNNER_ERROR_COUNT=0
TEST_RUNNER_SUCCESS_COUNT=0
TEST_RUNNER_SILENT=

__test_file_link_target() {
  local file="${1:-}"
  local line="${2:-1}"
  local column="${3:-1}"

  printf '%s:%s:%s' "$file" "$line" "$column"
}

__format_colon_label() {
  local value="${1:-}"
  [[ "$value" == *":"* ]] || { printf '%s' "$value"; return 0; }

  local prefix="${value%%:*}"
  local suffix="${value#*:}"
  printf '%s%s%s%s' $'\033[31;1m' "${prefix}:" $'\033[0m' "${suffix}"
}

__assert_lib_pass_or_fail() {

  # result is always the first
  # comment is always the second
  local res=$1
  local comment="$2"

  shift 2 # remove result & comment

  if [[ -n "${comment}" ]]; then
    [[ $# -gt 0 ]] && comment="${comment//#1/\'${1}\'}"
    [[ $# -gt 1 ]] && comment="${comment//#2/\'${2}\'}"

    if [[ "${comment::2}" == "--" ]]; then
      if [[ $res == true ]]; then
        (( TEST_RUNNER_SUCCESS_COUNT+=1 ))
        return 0 # return without printing
      fi
      comment="${comment:2:${#comment}}"
    fi
  fi

  if [[ $res == true ]]; then
    (( TEST_RUNNER_SUCCESS_COUNT+=1 ))
    # \u2714\ufe0f
    # \u2705'
    #success="PASSED"
    #echo -e "${TEST_INDENT}\033[32mPASSED\033[00m: $comment"
    (( ! TEST_RUNNER_SILENT )) && {
      printf '%s\033[32m\u2705\ufe0f - \033[00m%s\n' "${TEST_INDENT}" "${comment}"
    }
  else
    ((TEST_RUNNER_ERROR_COUNT+=1))

    local lineNo="${BASH_LINENO[1]}"
    local fileName="${BASH_SOURCE[2]:-${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}}"

		printf "%s\n" "$(__format_colon_label "${comment}")"
		printf "%s\n" "$(__format_colon_label "${TEST_INDENT}Assertion failed: ${fileName}, ${lineNo}")"

		for (( i=1; i <= "$#"; i++ )); do
			local arg_value="${!i}"
			local formatted_arg="$arg_value"
			if [[ "$arg_value" == *":"* ]]; then
				formatted_arg="$(__format_colon_label "$arg_value")"
			fi
			#printf '%s%s%q\n' "${TEST_INDENT}  " "${!i}"
			printf '%s%s\n' "${TEST_INDENT}  " "${formatted_arg}"
		done

    if [[ $EXIT_ON_FAILED_TEST  ]]; then
      exit 255
    fi
  fi
  # some true results are formed from fails (file not exist etc..)
  # so make sure we an exit code based on the result
  #[[ $res ]] && return 0
  return 0
}

__set_comment() {
  local -n _comment="$1"
  if [[ -z "$_comment" || "$_comment" == "--" ]]; then
    _comment+="$2"
  fi
}

TEST_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$TEST_LIB_DIR/test-lib-assert"


###################################
# Runs an array of test functions
# Arguments:
#   $1 an array of functions to run
#
# Each function is run in its own
# issolated process '(...)''
###################################
test_runner() {
  local -i summary=0
   [[ "${1:-}" == "--summary" ]] && { shift; summary=1; }

  local -n _tests="$1"
  local -n _comments="$2"
  local -n _lines="$3"
  local test_file="${4:-}"
  local -i i=0
  local error_count=0
  local success_count=0
  local tmpFile="/tmp/test-runner-${BASHPID}"
  local -i res=
  local saved_TEST_RUNNER_SILENT=$TEST_RUNNER_SILENT
  local style=
  local output=
  local icon=

  if (( summary )); then
    TEST_RUNNER_SILENT=1
  fi

  # shellcheck disable=SC2329,SC2317
  cleanup() {
    TEST_RUNNER_SILENT=${saved_TEST_RUNNER_SILENT:-}
    rm -f "/tmp/test-runner-${BASHPID}"
  }

  set_print_style() {

    if (( res != 0 )) && (( res != 255 )); then
      output="---Syntax error---"$'\n'"$output"$'\n'
      style='\033[1;35m'
      icon=
    elif (( TEST_RUNNER_ERROR_COUNT > 0 )); then
      style='\033[31;1m'
			icon=$'\u274c\ufe0f'
			#icon='\u2716'
    elif (( TEST_RUNNER_SUCCESS_COUNT > 0 )); then
      style='\033[32m'
			icon=$'\u2705\ufe0f'
    elif (( res == 0 )); then
      style='\033[32m'
			icon=$'\u2705\ufe0f'
    else
      style='\033[1;37m'
      icon=
    fi
  }

  # shellcheck disable=SC2329,SC2317
  exit_test() {
    rm -f "$tmpFile"
    printf '%s\n%s\n' \
      "TEST_RUNNER_SUCCESS_COUNT=${TEST_RUNNER_SUCCESS_COUNT}" \
      "TEST_RUNNER_ERROR_COUNT=${TEST_RUNNER_ERROR_COUNT}" >"$tmpFile"
    [[ $(type -t post_test_runner) == function ]] && {
      post_test_runner; }
  }

  box_string() {
    local string="$1"
    local -i stringLen=${#string}
    (( stringLen += 2 )) # +2 for spaces around string
    [[ -n $icon ]] && (( stringLen += 2 )) # +1 icon +1 space
    # printf -v "horz" '%.s─' $(seq 1 $stringLen) # create horizontal line in var horz
    # printf "${style}"'\u250c%s\u2510\n\u2502'"${icon}"' %s \u2502\n\u2514%s\u2518\n\e[m' "$horz" "$string" $horz

		printf -v horz '%*s' "$stringLen" ''
    horz=${horz// /─}

    printf "${style}"'\u250c%s\u2510\n\u2502'"${icon}"' %s \u2502\n\u2514%s\u2518\n\e[m' "$horz" "$string" "$horz"
  }

  trap 'cleanup' EXIT

  for i in "${!_tests[@]}"; do
    TEST_RUNNER_ERROR_COUNT=0
    TEST_RUNNER_SUCCESS_COUNT=0

    output=$(
      trap "exit_test" EXIT
      [[ $(type -t pre_test_runner) == function ]] && {
        pre_test_runner; }

      ${_tests[$i]} 2>&1
    )
    res=$?

    # shellcheck disable=SC1090
    if [[ -f "$tmpFile" ]]; then

      source "$tmpFile"
      success_count=$(( success_count+=TEST_RUNNER_SUCCESS_COUNT ))
      error_count=$(( error_count+=TEST_RUNNER_ERROR_COUNT ))

      rm -f "$tmpFile"
    fi

    set_print_style
    local comment=;comment="${_comments[$i]}"
    if [[ -z "${comment}" ]]; then
      comment="${_tests[$i]//_/ }"
    fi

    local label_text="$(( i+1 ))) '${comment}'"
    local label_target=
    [[ -n "$test_file" ]] && label_target="$(__test_file_link_target "$test_file" "${_lines[$i]:-1}" 1)"

    printf '%b%s %s' "${style}" "${icon}" "${label_text}"
    [[ -n "$label_target" ]] && printf ' %b%s' $'\e[2m' "$label_target"
    printf '%b\n' $'\e[0m'

    [[ -n "$output" ]] && printf "${style}"'%s\n\e[0m' "$output"

    if (( res != 0 )) && [[ $EXIT_ON_FAILED_TEST  ]]; then
      break
    fi
  done

  local total_count=$((success_count + error_count))
  box_string "Tests completed: ${total_count} total; ${success_count} succeeded; ${error_count} failed"

  TEST_RUNNER_ERROR_COUNT=0
  TEST_RUNNER_SUCCESS_COUNT=0

  if (( res != 0 )) && [[ $EXIT_ON_FAILED_TEST  ]]; then
    exit 1
  fi

}

###################################
# Gets an array of public test functions
# from a file and then executes each
# function in a separate process
# Arguments:
#   $1 - optional; pass --summary, used to display
#      a summary of the tests rather than showing
#      each result
#   $1 - required; The file containing the
#        tests to run
#   $2 - optional; Filters the name of the test
#        The default filter is "^assert_*"
# Each function is run in its own
# isolated process '(...)''
###################################
test_runner_all() {

  local -a summary=()
  [[ "$1" == "--summary" ]] && { shift; summary=(--summary); }

  local file="${1:-${BASH_SOURCE[1]}}"
  local filter="${2:-^test_.*}"

  [[ -f "$file" ]] || { echo "file not found: $file" >&2; return 1; }
  file="$(cd "$(dirname "$file")" && pwd)/$(basename "$file")"

  # shellcheck disable=SC2034
  local -a tests comments lines

  __get_public_functions "$file" "$filter" tests comments lines

  #echo "testrunner test func count: ${#tests[@]}"
  #for i in "${!tests[@]}"; do
  #  echo "testrunner test func: ${tests[i]}"
  #done
  #tests=("test1" "test2")
  #comments=("comment1" "comment2")
  test_runner "${summary[@]}" tests comments lines "$file"

}

###################################
# test runner for a complete set of
# tests in a file
# Arguments:
#   $1 - optional; pass --summary, used to display
#      a summary of the tests rather than showing
#      each result
#   $1 - required The file to load using the source command
#   $2 - optional bash regx filter used filter the
#      functions names
# Notes:
# The source file is loaded into a
# separate process before calling
# test_runner_all to run all the tests in the file.
###################################

test_runner_on_source_file() {

  (
      local summary=()
      [[ "${1:-}" == "--summary" ]] && { shift; summary=("--summary"); }
      local src="${1:-${BASH_SOURCE[1]}}"
      local filter="${2:-}"
      local src_display="$src"

    if [[ -f "$src" ]]; then
      src_display="$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
    fi

    if head -n 10 "$src" | grep -iq "# test-runner-ignore"; then
      echo "file: $1"
      echo "test-runner:file ignored: file contains # test-runner-ignore tag" >&2
      return 0;
    fi

    #shellcheck disable=SC1090
    source "$src"

    printf '\n\e[48;5;25m%s\e[K\e[0m\n' "$src_display"

    test_runner_all "${summary[@]}" "${src}" "${filter}"

  )
}

__parse_test_summary_totals() {
  local output="$1"
  local summary_line=""

  summary_line="$(printf '%s\n' "$output" | sed -n 's/.*Tests completed: \([0-9][0-9]*\) total; \([0-9][0-9]*\) succeeded; \([0-9][0-9]*\) failed.*/\1 \2 \3/p' | tail -n 1)"
  printf '%s' "$summary_line"
}

test_runner_on_source_files() {
  local show_totals=0
  local summary_mode=0
  local -a source_files=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --summary)
        summary_mode=1;;
      --show-totals)
        show_totals=1;;
      --)
        shift
        source_files+=("$@")
        break;;
      *)
        source_files+=("$1");;
    esac
    shift
  done

  local total_tests=0
  local total_success=0
  local total_failed=0
  local output_file
  local output
  local file_total=0
  local file_success=0
  local file_failed=0
  local test_file
  local -a runner_args=()

  for test_file in "${source_files[@]}"; do
    runner_args=()
    (( summary_mode )) && runner_args+=(--summary)
    runner_args+=("$test_file")

    if (( show_totals )); then
      output_file="$(mktemp)"
      test_runner_on_source_file "${runner_args[@]}" >"$output_file" 2>&1
      output="$(<"$output_file")"
      rm -f "$output_file"

      printf '%s\n' "$output"

      read -r file_total file_success file_failed < <(__parse_test_summary_totals "$output")
      total_tests=$((total_tests + file_total))
      total_success=$((total_success + file_success))
      total_failed=$((total_failed + file_failed))
    else
      test_runner_on_source_file "${runner_args[@]}"
    fi
  done

  if (( show_totals )); then
    printf 'All tests completed: %s total; %s succeeded; %s failed\n' "$total_tests" "$total_success" "$total_failed"
  fi
}

__get_public_functions() {
  local file="$1"
  local filter="$2"
  local -n _names="$3"
  local -n _comments="$4"
  local -n _lines="$5"

  _names=()
  _comments=()
  _lines=()

  [[ -f "$file" ]] || return 1

  local last_comment=""
  local fn="" pending_func="" pending_line=""
  local -i line_no=0

  while IFS= read -r line; do
    (( line_no += 1 ))
    # Capture single comment line
    if [[ "$line" =~ ^[[:space:]]*#[[:space:]]*(.*)$ ]]; then
      last_comment="${BASH_REMATCH[1]}"
      continue
    fi

    # Reset comment on blank or non-comment, non-function line

      # Match function definitions
    if [[ -n $pending_func ]]; then
      if [[ $line =~ ^[[:space:]]*\{ ]]; then
        fn="$pending_func"
        line_no=$pending_line
        pending_func=""
        pending_line=""
      else
        continue
      fi
    else
      [[ "$line" =~ ^[[:space:]]*$ ]] && { last_comment=""; continue; }
      [[ ! "$line" =~ ^[[:space:]]*(function[[:space:]]+)?[a-zA-Z_] ]] && last_comment=""

      if [[ "$line" =~ ^[[:space:]]*(function[[:space:]]+)?([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*(\(\))?[[:space:]]*\{ ]]; then
        fn="${BASH_REMATCH[2]}"

      elif [[ $line =~ ^[[:space:]]*((function[[:space:]]+([a-zA-Z_][a-zA-Z0-9_]*))|(([a-zA-Z_][a-zA-Z0-9_]*)[[:space:]]*\(\)))[[:space:]]*$ ]]; then
        pending_func="${BASH_REMATCH[4]:-${BASH_REMATCH[6]}}"
        pending_line=$line_no
      fi
    fi

    if [[ -n $fn ]]; then
      local _fn="$fn"
      local _line=$line_no
      fn=""
      # Skip private functions
      [[ "$_fn" == _* ]] && last_comment="" && continue

      # Optional filter

      [[ -n "$filter" && ! "$_fn" =~ $filter ]] && last_comment="" && continue

      _names+=("$_fn")
      _comments+=("$last_comment")
      _lines+=("$_line")
      last_comment=""
    fi
  done < "$file"

}
