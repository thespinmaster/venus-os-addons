  chmod +x "$opkg_rc_local_d_dir/6/ccc.b" "$opkg_rc_local_d_dir/4/uuu" "$opkg_rc_local_d_dir/6/ddd"

  [[ -f "$opkg_rc_local_d_dir/startup.log" ]] && rm "$opkg_rc_local_d_dir/startup.log"

  # Act
  stdout=$("$startup_script_file")

  # Assert
  assert_file_exists "$opkg_rc_local_d_dir/startup.log"

  expected_order=$'script 2 xxx\nscript 2 yyy\nscript 4 uuu\nscript 6 ccc.d\nscript 6 ddd\nscript 10 bbb'

  assert_eq "$expected_order" "$stdout"
