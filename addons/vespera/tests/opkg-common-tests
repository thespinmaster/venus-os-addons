# copied all the data/opkg-manager/* files to
# the output_dir as symlinks
stage_opkg_helpers_installed() {

  local dest_path="${venus_root_dir:?}"
  local source_path="$this_path/../src"
  local -a paths

  [[ -d "$dest_path" ]] && {
    mapfile -t paths < <(find "${dest_path}") # does not return symlinks
    for path in "${paths[@]}"; do
      [[ "$path" == "$dest_path" ]] && continue
      [[ -d "$path" ]] && {
        [[ "$path" == "$dest_path/data" ]] && continue
        [[ "$path" == "$dest_path/data/opkg-manager" ]] && continue
        [[ "$path" == "$dest_path/data/opkg-manager/libs" ]] && continue

        [[ "$path" == "$dest_path/etc"* ]] && continue
      }
      [[ -L "$path" ]] || {
        [[ -d $path ]] && rm -r "$path";
        [[ -f $path ]] && rm "$path";
        #echo $path
        #echo $dest_path
        }
    done

    return
  }

  source_path="$(realpath "$source_path")"

  local paths path new_path exclude_path2 exclude_path3

  mapfile -t paths < <(find "${source_path}")
  exclude_path="$source_path/CONTROL"
  exclude_path3="$source_path/qmlplugin"

  for path in "${paths[@]}"; do
    [[ "$path" == "$exclude_path"* ]] && continue
    [[ "$path" == "$exclude_path3"* ]] && continue

    new_path="${path/$source_path/$dest_path}"

    if [[ -d "$path" ]]; then
      mkdir -p $new_path
    else
      ln -s "$path" "$new_path"
    fi
  done

  mkdir -p "${venus_root_dir:?}/etc/opkg/"

  return 0
}

if [[ "${0:-}" == "${BASH_SOURCE[0]}" ]]; then
  stage_opkg_helpers_installed
fi

