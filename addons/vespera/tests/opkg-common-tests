test_startup_script_executes_scripts_in_correct_order() {
  # Arrange
  local stdout
  local startup_script_file="$opkg_rc_local_d_dir/startup"

  mkdir -p "$opkg_rc_local_d_dir/2" "$opkg_rc_local_d_dir/6" "$opkg_rc_local_d_dir/4" "$opkg_rc_local_d_dir/10"

  echo "echo \"script 2 yyy\"" > "$opkg_rc_local_d_dir/2/yyy"
  echo "echo \"script 2 xxx\"" > "$opkg_rc_local_d_dir/2/xxx"
  echo "echo \"script 10 bbb\"" > "$opkg_rc_local_d_dir/10/bbb"
  echo "echo \"script 6 ddd\"" > "$opkg_rc_local_d_dir/6/ddd"
  echo "echo \"script 4 uuu\"" > "$opkg_rc_local_d_dir/4/uuu"
  echo "echo \"script 6 ccc.d\"" > "$opkg_rc_local_d_dir/6/ccc.b"

