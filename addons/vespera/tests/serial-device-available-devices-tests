#!/usr/bin/env bash

set -o nounset

this_path="$(dirname "${BASH_SOURCE[0]}")"
. "$this_path/../../../scripts/libs/test-lib"
. "$this_path/../src/data/apps/available/vespera/libs/serial-device-installer-lib"

__stage_base_paths() {
  local -n _base_ref="$1"
  _base_ref="/tmp/vespera-available-devices-tests"
  rm -rf -- "$_base_ref"
  mkdir -p -- "$_base_ref"
}


test_get_available_devices_returns_free_ttys_when_serial_starter_is_down() {
  # Arrange
  local base=""
  __stage_base_paths base
  local SERIAL_STARTER_DEV_DIR="$base/dev"
  local tty0="$SERIAL_STARTER_DEV_DIR/ttyUSB0"
  local tty1="$SERIAL_STARTER_DEV_DIR/ttyACM0"
  mkdir -p "$SERIAL_STARTER_DEV_DIR"
  : > "$tty0"
  : > "$tty1"

  __sdi_get_tty_paths() {
    local -n _out="$1"
    _out=("$tty0" "$tty1")
  }

  svstat() {
    echo "/service/serial-starter: down"
  }

  fuser() {
    return 1
  }

  readlink() {
    return 1
  }

  rm() {
    return 0
  }

  local out=

  # Act
  out="$(sdi_get_available_devices)"

  # Assert
  assert_exitcode 0
  assert_eq $'ttyUSB0\nttyACM0' "$out"
}


