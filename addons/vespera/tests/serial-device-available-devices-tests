#!/usr/bin/env bash

set -o nounset

this_path="$(dirname "${BASH_SOURCE[0]}")"
. "$this_path/../../../scripts/libs/test-lib"
. "$this_path/../src/data/opkg-manager/serial-device-installer"


__stage_base_paths() {
  local -n _base_ref="$1"
  _base_ref="/tmp/opkg-manager-available-devices-tests"
  rm -rf "$_base_ref"
  mkdir -p "$_base_ref"
}


test_get_available_devices_lists_repeated_failures() {
  # Arrange
  local base=""
  __stage_base_paths base
  local tty0="$base/sys/class/tty/ttyUSB0"
  local tty1="$base/sys/class/tty/ttyACM0"
  local SERIAL_STARTER_QUEUE_DIR="$base/dev/serial-starter"
  local SERIAL_STARTER_SERVICE_DIR="$base/service"
  local SERIAL_STARTER_LOCK_DIR="$base/lock"
  local SERIAL_STARTER_FAILURE_MIN_DOWN_SECONDS=15
  mkdir -p "${tty0%/*}" "${tty1%/*}"
  mkdir -p "$SERIAL_STARTER_QUEUE_DIR" "$SERIAL_STARTER_SERVICE_DIR" "$SERIAL_STARTER_LOCK_DIR"
  : > "$tty0"
  : > "$tty1"
  : > "$SERIAL_STARTER_QUEUE_DIR/ttyUSB0"
  : > "$SERIAL_STARTER_QUEUE_DIR/ttyACM0"
  : > "$SERIAL_STARTER_SERVICE_DIR/testA.ttyUSB0"
  : > "$SERIAL_STARTER_SERVICE_DIR/testB.ttyACM0"

  serial_device_installer_get_tty_paths() { echo "$tty0 $tty1"; }

  __serial_device_installer_svstat() {
    case "$1" in
      *ttyUSB0) echo "$1: down 100 seconds" ;;
      *ttyACM0) echo "$1: down 99 seconds" ;;
    esac
  }

  local out=

  # Act
  out="$(serial_device_installer_get_available_devices)"

  # Assert
  assert_exitcode 0
  assert_eq $'ttyUSB0\nttyACM0' "$out"
}


