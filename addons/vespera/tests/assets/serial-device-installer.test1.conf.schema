#NAME    | TYPE           | REQUIRED  | DEFAULT
#examples###############################################
#PORT     | int           | required  | 8080 
#DEBUG    | bool          |           | false
#MODE     | enum:dev,prod |           | dev
#MESSAGE  | string        |           |

# DEVICE_SERVICE_NAME: The name of the service
# DEVICE_SERVICE_MAPPING_NAME: The ve_service name used in the serial-starter-rules file
#                        and mapped in the serial-starter.conf file
#                        if not set mapping name of "ve_$DEVICE_SERVICE_NAME" is used
# DEVICE_TTY: The tty port name used to get
# SERVICE_PATH: The path services are copied to
# SERIAL_STARTER_START_SERVICE_PATH: The path used by the serial-starter to monitor for new tty services
# SERIAL_STARTER_RULES_FILE: The path to the serial-starter-rules file
# SERIAL_STARTER_RULES_FILE_SYMLINK: The udev rules path symlink to SERIAL_STARTER_RULES_FILE
# SERIAL_STARTER_CONFIG_FILE: The file that contains the mapping from the ve_service to the actual service
# DEVICE_UDEV_PROPS: The properties to query for when creating the serial starter rule
# USE_UDEVADM_MONITOR: use udevadm --monitor to detect a new usb device. otherwise use lsusb
 
DEVICE_SERVICE_NAME                      | string | required | 
DEVICE_SERVICE_MAPPING_NAME              | string |          | 
DEVICE_TTY                               | string |          |
SERVICE_PATH                      | string | required | /service 
SERIAL_STARTER_START_SERVICE_PATH | string | required | /dev/serial-starter
SERIAL_STARTER_RULES_FILE         | string | required | /home/admin/dev/projects/venus-os/addons/opkg-manager/tests/output/serial-starter.rules
SERIAL_STARTER_RULES_FILE_SYMLINK | string |          | /home/admin/dev/projects/venus-os/addons/opkg-manager/tests/output/opkg-manager-serial-starter.rules
DEVICE_UDEV_PROPS                     | string | required | ID_BUS=,ID_VENDOR=,ID_MODEL=,ID_SERIAL=
USE_UDEVADM_MONITOR               | int    |          | 1
USB_TIMEOUT                       | int    |          | 30