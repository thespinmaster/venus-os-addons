#!/usr/bin/env bash

vt_make_test_root() {
	local this_path;this_path="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  mktemp -d "$this_path/output/vespera-tests.XXXXXX"
}
vt_set_conf_value() {
  local name="$1"
  local value="$2"
  sed -i "s|^${name}=.*|${name}=${value}|" "$TEST_APP_ROOT/conf/vespera.conf"
}

vt_safe_rm_rf() {
  local path="${1:-}"
  local target=""
  local parent=""
  local base=""
  local tomb=""
  local original_path=""
  local tries=60
  local rm_tries=60

  [[ -n "$path" ]] || return 0
  [[ "$path" == /tmp/vespera-tests.* || "$path" == /data/dev/addons/vespera/tests/output/vespera-tests.* || "$path" == */vespera-tests.* ]] || {
    echo "refusing to remove non-test path: $path" >&2
    return 1
  }

  [[ -e "$path" ]] || return 0

  original_path="$path"
  parent="$(dirname "$path")"
  base="$(basename "$path")"

  while (( tries > 0 )); do
    tomb="$parent/.${base}.deleting.${BASHPID}.${RANDOM}.deferred"

    if mv -- "$original_path" "$tomb" 2>/dev/null; then
      target="$tomb"
    else
      target="$original_path"
    fi

    rm_tries=60
    while (( rm_tries > 0 )); do
      rm -rf -- "$target" 2>/dev/null || true
      [[ ! -e "$target" ]] && return 0
      sleep 0.1
      ((rm_tries--))
    done

    [[ ! -e "$original_path" ]] && return 0

    sleep 0.1
    ((tries--))
  done

  # Last resort: detach if possible and clean up in background.
  tomb="$parent/.${base}.deleting.${BASHPID}.${RANDOM}.deferred"
  if mv -- "$original_path" "$tomb" 2>/dev/null; then
    (
      local bg_tries=120
      while (( bg_tries > 0 )); do
        rm -rf -- "$tomb" 2>/dev/null || true
        [[ ! -e "$tomb" ]] && exit 0
        sleep 0.5
        ((bg_tries--))
      done
      exit 0
    ) >/dev/null 2>&1 &
    return 0
  fi

  if [[ ! -e "$original_path" ]]; then
    return 0
  fi

  return 1
}
