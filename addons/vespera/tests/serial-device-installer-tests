test_remove_rule_succeeds_when_sid_set_removes_comment_and_rule_line() {

  # Arrange
  stage_default_vars
  cat >"${SERIAL_STARTER_RULES_FILE}" <<'EOF'
# keep: unrelated
ACTION=="add", ENV{ID_BUS}=="usb", ENV{ID_SERIAL}=="KEEP", ENV{VE_SERVICE}="ve_keep"
# # sid:abc123: dummy_service
ACTION=="add", ENV{ID_BUS}=="usb", ENV{SERIAL_DEVICE_ID}="abc123", ENV{ID_SERIAL}=="REMOVE", ENV{VE_SERVICE}="ve_remove"
# keep: unrelated 2
ACTION=="add", ENV{ID_BUS}=="usb", ENV{ID_SERIAL}=="KEEP2", ENV{VE_SERVICE}="ve_keep2"
EOF

  DEVICE_SID="abc123"

  local stderr=

  # Act
  stderr="$(sdi_remove_rule 2>&1)"

  # Assert
  assert_exitcode 0
  local count_of=
  count_of=$(grep -c '^# sid:abc123:' "${SERIAL_STARTER_RULES_FILE}")
  assert_eq 0 "$count_of"

  count_of=$(grep -c 'ENV{SERIAL_DEVICE_ID}="abc123"' "${SERIAL_STARTER_RULES_FILE}")
  assert_eq 0 "$count_of"

  count_of=$(grep -c 'ENV{ID_SERIAL}=="KEEP"' "${SERIAL_STARTER_RULES_FILE}")
  assert_eq 1 "$count_of"

  count_of=$(grep -c 'ENV{ID_SERIAL}=="KEEP2"' "${SERIAL_STARTER_RULES_FILE}")
  assert_eq 1 "$count_of"
  assert_empty "$stderr"
}

