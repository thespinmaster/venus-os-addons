# shellcheck disable=SC2120
stage_reset_vars() {
  local -a vars=()
  # shellcheck disable=SC2199
  if [[ -n "$@" ]]; then
    vars=(DEVICE_SID DEVICE_SERVICE_NAME DEVICE_SERVICE_MAPPING_NAME DEVICE_TTY SERVICE_PATH SERIAL_STARTER_START_SERVICE_PATH
          SERIAL_STARTER_RULES_FILE SERIAL_STARTER_RULES_FILE_SYMLINK SERIAL_STARTER_CONFIG_FILE
          VENUS_OS_SERIAL_STARTER_CONFIG_FILE DEVICE_UDEV_PROPS USE_UDEVADM_MONITOR)
  else
    vars=("$@")
  fi

  for var in "${vars[@]}"; do unset -v "$var" ;done;
}

# shellcheck disable=SC2120
stage_default_vars() {
  DEVICE_SID= #ef2d
  _TTY=ttyUSB0
  DEVICE_SERVICE_NAME="${1:-dummy_service}"
  DEVICE_SERVICE_MAPPING_NAME="ve_${DEVICE_SERVICE_NAME}"
  DEVICE_TTY=
  SERVICE_PATH="$output_dir/service"
  SERIAL_STARTER_START_SERVICE_PATH="$output_dir/serial-starter"
  #SERIAL_STARTER_RULE=
  SERIAL_STARTER_RULES_FILE="$output_dir/serial-starter.rules"
  SERIAL_STARTER_RULES_FILE_SYMLINK="$output_dir/vespera-serial-starter.rules"
  SERIAL_STARTER_CONFIG_FILE="$output_dir/serial-starter.conf"
  VENUS_OS_SERIAL_STARTER_CONFIG_FILE="$output_dir/venus-serial-starter.conf"
  SERIAL_STARTER_DEV_DIR="$output_dir/dev"
  DEVICE_UDEV_PROPS="ID_BUS,ID_VENDOR,ID_MODEL,ID_SERIAL"
  USE_UDEVADM_MONITOR="1"

  mkdir -p "$SERIAL_STARTER_DEV_DIR"
  for tty in tty ttyUSB0 ttyACM0; do : > "$SERIAL_STARTER_DEV_DIR/${tty}" || true; done
}

# shellcheck disable=SC2120
stage_files() {

  local args=("$@")
  (( ${#args[@]} == 0 )) && {
    args=("serial-device-installer.test1.conf")
  }

  clear_output
  mkdir -p "$SERIAL_STARTER_DEV_DIR"
  for tty in tty ttyUSB0 ttyACM0; do : > "$SERIAL_STARTER_DEV_DIR/${tty}" || true; done

  for file in "${args[@]}"; do
    mkdir -p "$(dirname "${output_dir}/${file}")"
    if [ -f "${assets_dir}/${file}" ]; then
      cp "${assets_dir}/${file}" "${output_dir}/${file}"
    else
      : > "${output_dir}/${file}"
    fi
    chmod +w "${output_dir}/${file}"
  done

  return 0
}


