test_installer_lib_get_patch_file_list_extracts_openfile_paths() {
  local root
  root="$(vt_make_test_root)"
  stage_installer_runtime "$root"

  cat > "$root/work/sample.patch" <<'EOF'
# comment should be ignored
@openfile
====
/tmp/a.conf
====

@remove
====
foo
====

@openfile
====
/tmp/b.conf
====
EOF

  local output
  output="$(run_installer_probe "$root" configure 'installer_lib_get_patch_file_list "$ROOT_DIR/work/sample.patch"')"

  assert_exitcode 0
  assert_eq $'/tmp/a.conf\n/tmp/b.conf' "$output"

  vt_safe_rm_rf "$root"
}

