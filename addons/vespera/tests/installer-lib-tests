test_installer_lib_phase_sync_custom_nav_pages_calls_sync_helper() {
  local root
  root="$(vt_make_test_root)"
  stage_installer_runtime "$root"

  local probe_output="$root/work/probe.out"
  run_installer_probe "$root" configure 'installer_lib_initialize; installer_lib_phase_sync_custom_nav_pages add; cat "$PROBE_LOG"' >"$probe_output"

  assert_exitcode 0
  assert_file_contains "$probe_output" 'sync:add|demo|PageA PageB'

  vt_safe_rm_rf "$root"
}

if [[ "${0:-}" == "${BASH_SOURCE[0]}" ]]; then
  test_runner_all --summary ""
fi
