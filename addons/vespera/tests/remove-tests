#!/usr/bin/env bash

set -o nounset

this_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_root="$this_path/../src/data/apps/available/vespera"

. "$this_path/../../../scripts/libs/test-lib"
. "$this_path/lib/vespera-test-fixtures"

TEST_ROOT=

stage_remove_runtime() {
  TEST_ROOT="$(vt_make_test_root)"

  mkdir -p "$TEST_ROOT/data/apps/available/vespera/scripts"
  mkdir -p "$TEST_ROOT/data/apps/available/vespera/libs"
  mkdir -p "$TEST_ROOT/data/apps/available/demo/conf"
  mkdir -p "$TEST_ROOT/data/var/vespera/info"
  mkdir -p "$TEST_ROOT/work"

  cp "$source_root/scripts/remove" "$TEST_ROOT/data/apps/available/vespera/scripts/remove"
  chmod +x "$TEST_ROOT/data/apps/available/vespera/scripts/remove"

  sed -i "s|source \"\${VESPERA_ROOT:-}/data/apps/available/vespera/libs/installer-lib\" \"\$@\"|source \"$TEST_ROOT/data/apps/available/vespera/libs/installer-lib\" \"\$@\"|" "$TEST_ROOT/data/apps/available/vespera/scripts/remove"
  sed -i "s|/data/rcS.local|$TEST_ROOT/data/rcS.local|g" "$TEST_ROOT/data/apps/available/vespera/scripts/remove"
  sed -i "s|/data/rc.local|$TEST_ROOT/data/rc.local|g" "$TEST_ROOT/data/apps/available/vespera/scripts/remove"

  cat > "$TEST_ROOT/data/apps/available/vespera/libs/installer-lib" <<'EOF'
#!/usr/bin/env bash
PACKAGE_ACTION="${1:-}"
PACKAGE_INSTALLER_FILE="${2:-}"
VESPERA_WORKING_DIR="${3:-}"
VESPERA_VERBOSITY="${4:-0}"
PACKAGE_NAME="${PACKAGE_INSTALLER_FILE##*/}"; PACKAGE_NAME="${PACKAGE_NAME%.*}"
PACKAGE_INSTALL_DIR="${VESPERA_ROOT}/data/apps/available"
PACKAGE_DATA_INFO_DIR="$(dirname "$PACKAGE_INSTALLER_FILE")"
VESPERA_DATA_DIR="${VESPERA_ROOT}/data/var/vespera"
VESPERA_PATCH_LIST_FILE="${VESPERA_ROOT}/data/var/vespera/patch.list"
VESPERA_INSTALL_STATE_FILE="install-state"
VESPERA_APP_SERVICES_FILE="app-services"
VESPERA_APP_TEMPLATE_SERVICES_FILE="app-template-services"
VESPERA_DBUS_NAME="dbus-name"
PACKAGE_DBUS_NAME="com.example.${PACKAGE_NAME}"
PACKAGE_DBUS_LIST_FILE="$VESPERA_DATA_DIR/info/$PACKAGE_NAME.dbus-list"
PACKAGE_CUSTOM_NAV_PAGES=
RCS_LOCAL_SCRIPT=
RC_LOCAL_SCRIPT=
LANG_INSTALL_ACTION_ARG1=install_action
LANG_REVERTING_PATCHED_FILES=reverting

source "$PACKAGE_INSTALLER_FILE"

echo_lang() { :; }
installer_lib_initialize() { :; }
installer_lib_log_verbose2() { return 1; }
installer_lib_is_upgrade() {
  [[ "$PACKAGE_ACTION" == upgrade-* || "$PACKAGE_ACTION" == "upgrade-remove" || "$PACKAGE_ACTION" == "upgrade-remove-post" ]]
}
installer_lib_update_install_list() {
	printf 'demo removed\n' >> "$VESPERA_WORKING_DIR/install-state"
}
installer_lib_phase_sync_custom_nav_pages() {
  printf 'sync-nav:%s\n' "$1" >> "$VESPERA_ROOT/remove.log"
}
installer_dbus_lib_remove() {
  printf 'remove-dbus:%s\n' "$1" >> "$VESPERA_ROOT/remove.log"
}
installer_lib_get_patch_file_list() { :; }
file_patcher_revert_patch() { :; }
sdi_remove_service_mapping() {
  printf 'serial-map-remove:%s\n' "$DEVICE_SERVICE_NAME" >> "$VESPERA_ROOT/remove.log"
}
addsource() {
  case "$1" in
    libs/serial-device-installer-lib)
      source "${VESPERA_ROOT}/data/apps/available/vespera/libs/serial-device-installer-lib" ;;
    libs/file-patcher-lib)
      source "${VESPERA_ROOT}/data/apps/available/vespera/libs/file-patcher-lib" ;;
    libs/file-lib)
      source "${VESPERA_ROOT}/data/apps/available/vespera/libs/file-lib" ;;
  esac
}
__try_call() {
  local fn="$1"
  shift || true
  if declare -F "$fn" >/dev/null; then
    "$fn" "$@"
  fi
}
EOF
  chmod +x "$TEST_ROOT/data/apps/available/vespera/libs/installer-lib"

  cat > "$TEST_ROOT/data/apps/available/vespera/scripts/remove-services" <<'EOF'
#!/usr/bin/env bash
printf 'remove-services:%s\n' "$*" >> "$VESPERA_ROOT/remove.log"
EOF
  chmod +x "$TEST_ROOT/data/apps/available/vespera/scripts/remove-services"

  cat > "$TEST_ROOT/data/apps/available/vespera/libs/device-lib" <<'EOF'
#!/usr/bin/env bash
printf 'device-lib:%s\n' "$*" >> "$VESPERA_ROOT/remove.log"
EOF
  chmod +x "$TEST_ROOT/data/apps/available/vespera/libs/device-lib"

  cat > "$TEST_ROOT/data/apps/available/vespera/libs/serial-device-installer-lib" <<'EOF'
#!/usr/bin/env bash
sdi_remove_service_mapping() {
  printf 'serial-map-remove:%s\n' "$DEVICE_SERVICE_NAME" >> "$VESPERA_ROOT/remove.log"
}
EOF

  cat > "$TEST_ROOT/data/apps/available/vespera/libs/file-patcher-lib" <<'EOF'
#!/usr/bin/env bash
file_patcher_revert_patch() { :; }
EOF

  cat > "$TEST_ROOT/data/apps/available/vespera/libs/file-lib" <<'EOF'
#!/usr/bin/env bash
file_lib_remove_content_from_file() { :; }
EOF

  cat > "$TEST_ROOT/data/apps/available/demo/demo.installer" <<'EOF'
# package installer stub
EOF

  cat > "$TEST_ROOT/data/var/vespera/info/demo.installer-services" <<'EOF'
svc-a
EOF
  cat > "$TEST_ROOT/data/var/vespera/info/demo.app-services" <<'EOF'
svc-a
EOF
  cat > "$TEST_ROOT/data/var/vespera/info/demo.app-template-services" <<'EOF'
tpl-a
EOF
  cat > "$TEST_ROOT/data/var/vespera/info/demo.dbus-name" <<'EOF'
com.example.demo
EOF
  cat > "$TEST_ROOT/data/var/vespera/info/demo.dbus-list" <<'EOF'
{"path":"/Settings/Test","default":0,"min":0,"max":1}
EOF

  : > "$TEST_ROOT/remove.log"
}

cleanup_remove_runtime() {
  [[ -n "${TEST_ROOT:-}" ]] && vt_safe_rm_rf "$TEST_ROOT"
}

test_remove_script_updates_install_state_and_invokes_runtime_cleanup() {
  stage_remove_runtime

  VESPERA_ROOT="$TEST_ROOT" \
    bash "$TEST_ROOT/data/apps/available/vespera/scripts/remove" \
    remove "$TEST_ROOT/data/apps/available/demo/demo.installer" "$TEST_ROOT/work" 0

  assert_exitcode 0 "remove action exits successfully"
  assert_file_contains "$TEST_ROOT/work/install-state" 'demo removed' "remove marks package as removed in install-state"
  assert_file_contains "$TEST_ROOT/remove.log" 'remove-services:demo _' "remove invokes remove-services helper"
  assert_file_contains "$TEST_ROOT/remove.log" 'device-lib:remove-all com.example.demo' "remove clears bound devices for package dbus name"
  assert_file_contains "$TEST_ROOT/remove.log" 'remove-dbus:' "remove deletes package dbus settings"
  assert_file_not_exist "$TEST_ROOT/data/var/vespera/info/demo.dbus-name" "remove deletes package dbus-name file"

  cleanup_remove_runtime
}

test_remove_script_upgrade_remove_skips_non_upgrade_cleanup_steps() {
  stage_remove_runtime

  VESPERA_ROOT="$TEST_ROOT" \
    bash "$TEST_ROOT/data/apps/available/vespera/scripts/remove" \
    upgrade-remove "$TEST_ROOT/data/apps/available/demo/demo.installer" "$TEST_ROOT/work" 0

  assert_exitcode 0 "upgrade-remove action exits successfully"
  assert_file_contains "$TEST_ROOT/remove.log" 'remove-services:demo _' "upgrade-remove still stops/removes runtime services"
  assert_file_not_contain "$TEST_ROOT/remove.log" 'device-lib:remove-all' "upgrade-remove does not remove device bindings"
  assert_file_not_contain "$TEST_ROOT/remove.log" 'remove-dbus:' "upgrade-remove does not remove dbus settings file"

  cleanup_remove_runtime
}

if [[ "${0:-}" == "${BASH_SOURCE[0]}" ]]; then
  test_runner_all --summary ""
fi
