#!/usr/bin/env bash

set -o nounset

this_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_root="$this_path/../src/data/apps/available/vespera"

. "$this_path/../../../scripts/libs/test-lib"
. "$this_path/lib/vespera-test-fixtures"

TEST_ROOT=
TEST_APP_ROOT=

stage_rc_local_runtime() {
  TEST_ROOT="$(vt_make_test_root)"
  TEST_APP_ROOT="$TEST_ROOT/data/apps/available/vespera"

  mkdir -p "$TEST_APP_ROOT/scripts" "$TEST_APP_ROOT/conf" "$TEST_ROOT/var/log/vespera"

  cp "$source_root/conf-default/vespera.conf" "$TEST_APP_ROOT/conf/vespera.conf"
  cp "$source_root/scripts/rc-local" "$TEST_APP_ROOT/scripts/rc-local"
  chmod +x "$TEST_APP_ROOT/scripts/rc-local"

  cat > "$TEST_APP_ROOT/scripts/execute-startup-scripts" <<'EOF'
#!/usr/bin/env bash
printf 'execute:%s\n' "$*" >> "$TEST_LOG"
EOF
  chmod +x "$TEST_APP_ROOT/scripts/execute-startup-scripts"

  : > "$TEST_ROOT/rc-local.log"
}

cleanup_rc_local_runtime() {
  [[ -n "${TEST_ROOT:-}" ]] && vt_safe_rm_rf "$TEST_ROOT"
}

test_rc_local_execs_execute_startup_scripts_with_rc_local() {
  stage_rc_local_runtime

  TEST_LOG="$TEST_ROOT/rc-local.log" VESPERA_ROOT="$TEST_ROOT" bash "$TEST_APP_ROOT/scripts/rc-local"

  assert_exitcode 0
  assert_file_contains "$TEST_ROOT/rc-local.log" 'execute:rc.local'

  cleanup_rc_local_runtime
}

if [[ "${0:-}" == "${BASH_SOURCE[0]}" ]]; then
  test_runner_all --summary ""
fi
