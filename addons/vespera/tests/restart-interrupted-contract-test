#!/usr/bin/env bash

set -euo pipefail

SERVICE="com.victronenergy.opkgmanager"
PID_FILE="/data/opkg-manager.pid"
LOG_FILE="/var/log/opkg-manager/current"
EXPECTED_EXIT_CODE=75
EXPECTED_EXIT_STATUS=2
EXPECTED_ERROR="interrupted:service-restart"

DBUS_GET_BIN="dbus"

dbus_get() {
  "$DBUS_GET_BIN" -y "$SERVICE" "$1" GetValue 2>/dev/null || true
}

dbus_set() {
  "$DBUS_GET_BIN" -y "$SERVICE" "$1" SetValue "$2" >/dev/null
}

to_int() {
  local value="${1:-}"
  value="$(echo "$value" | sed -n 's/[^0-9-]*\(-\{0,1\}[0-9]\+\).*/\1/p' | head -n 1)"
  [[ -n "$value" ]] || value=0
  echo "$value"
}

to_string() {
  local value="${1:-}"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  echo "$value"
}

wait_for_nonzero_status() {
  local timeout_secs="${1:-5}"
  local end=$((SECONDS + timeout_secs))
  while (( SECONDS < end )); do
    local status
    status="$(to_int "$(dbus_get /State/Status)")"
    if (( status != 0 )); then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

wait_for_finished_seq_change() {
  local start_seq="$1"
  local timeout_secs="${2:-5}"
  local end=$((SECONDS + timeout_secs))

  while (( SECONDS < end )); do
    local current_seq
    current_seq="$(to_int "$(dbus_get /Event/FinishedSeq)")"
    if (( current_seq != start_seq )); then
      return 0
    fi
    sleep 0.05
  done

  return 1
}

log_contract_seen_since_line() {
  local start_line="$1"
  local pattern="Finished request_id=.* exit_code=${EXPECTED_EXIT_CODE} exit_status=${EXPECTED_EXIT_STATUS} error=${EXPECTED_ERROR}"

  [[ -f "$LOG_FILE" ]] || return 1

  tail -n "+${start_line}" "$LOG_FILE" | grep -Eq "$pattern"
}

main() {
  [[ -f "$PID_FILE" ]] || { echo "PID file not found: $PID_FILE"; exit 1; }

  local start_seq start_value args_json service_pid start_log_line
  start_seq="$(to_int "$(dbus_get /Event/FinishedSeq)")"
  start_log_line=1
  if [[ -f "$LOG_FILE" ]]; then
    start_log_line="$(( $(wc -l < "$LOG_FILE") + 1 ))"
  fi

  args_json='["test","test-loop"]'
  dbus_set /Request/ArgsJson "$args_json"

  start_value="$(to_int "$(dbus_get /Request/Start)")"
  dbus_set /Request/Start "$((start_value + 1))"

  if ! wait_for_nonzero_status 5; then
    echo "Command did not enter running state"
    exit 1
  fi

  service_pid="$(cat "$PID_FILE")"
  [[ -n "$service_pid" ]] || { echo "Empty service PID"; exit 1; }

  local shutdown_value
  shutdown_value="$(to_int "$(dbus_get /Request/Shutdown)")"
  echo "Requesting shutdown via D-Bus (service pid=$service_pid)"
  dbus_set /Request/Shutdown "$((shutdown_value + 1))"

  if ! wait_for_finished_seq_change "$start_seq" 5; then
    # Under fast supervisor restarts, polling can miss the short-lived terminal
    # D-Bus state even though the service emitted it. Fall back to service logs.
    if log_contract_seen_since_line "$start_log_line"; then
      echo "PASS: restart interruption contract confirmed via service logs"
      exit 0
    fi

    echo "Did not observe /Event/FinishedSeq increment before service exit"
    exit 1
  fi

  local exit_code exit_status error_token
  exit_code="$(to_int "$(dbus_get /Result/ExitCode)")"
  exit_status="$(to_int "$(dbus_get /Result/ExitStatus)")"
  error_token="$(to_string "$(dbus_get /Result/Error)")"

  [[ "$exit_code" == "$EXPECTED_EXIT_CODE" ]] || {
    echo "Unexpected ExitCode: got=$exit_code expected=$EXPECTED_EXIT_CODE"
    exit 1
  }

  [[ "$exit_status" == "$EXPECTED_EXIT_STATUS" ]] || {
    echo "Unexpected ExitStatus: got=$exit_status expected=$EXPECTED_EXIT_STATUS"
    exit 1
  }

  [[ "$error_token" == "$EXPECTED_ERROR" ]] || {
    echo "Unexpected Error token: got='$error_token' expected='$EXPECTED_ERROR'"
    exit 1
  }

  echo "PASS: restart interruption contract observed (ExitCode=$exit_code ExitStatus=$exit_status Error=$error_token)"
}

main "$@"
