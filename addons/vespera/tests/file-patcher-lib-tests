test_file_patcher_remove() {
  local case_dir target patch
  case_dir="$(make_temp_patch_case)"
  target="$case_dir/remove.txt"
  patch="$case_dir/remove.patch"

  write_patch_case_file "$target" \
    "alpha" \
    "marker" \
    "omega"

  write_patch_case_file "$patch" \
    "@openfile" \
    "====" \
    "$target" \
    "====" \
    "@remove" \
    "====" \
    "marker" \
    "===="

  "$patcher_script" apply "$patch"

  assert_files_eq "$target" <(printf 'alpha\n/*\nmarker\n*/\nomega\n') "remove wraps content in block comment markers"
  rm -rf -- "$case_dir"
}

if [[ "${0:-}" == "${BASH_SOURCE[0]}" ]]; then
  test_runner_all --summary ""
fi
