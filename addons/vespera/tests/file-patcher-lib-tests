  local case_dir target patch
  case_dir="$(make_temp_patch_case)"
  target="$case_dir/insertafter.txt"
  patch="$case_dir/insertafter.patch"

  write_patch_case_file "$target" \
    "alpha" \
    "marker" \
    "omega"

  write_patch_case_file "$patch" \
    "@openfile" \
    "====" \
    "$target" \
    "====" \
    "@find" \
    "====" \
    "marker" \
    "====" \
    "@insertafter" \
    "====" \
    "after-line" \
    "===="

  "$patcher_script" apply "$patch"

  assert_file_contains "$target" "after-line" "insertafter inserted content"
