export LANG_CODE=


function lang_common_set_lang_code() {
	local caller_path="${1}"

	# Always use dbus gui setting
	#if [[ "${RUNNING_FROM_GUI:-0}" == 1 ]]; then
		LANG_CODE="$(dbus -y com.victronenergy.settings /Settings/Gui/Language GetValue)"
		LANG_CODE="${LANG_CODE#\'}"; LANG_CODE="${LANG_CODE%\'}"
	#fi

	if [[ -z "${LANG_CODE}" ]]; then
		LANG_CODE="${LC_ALL:-${LC_MESSAGES:-${LC_CTYPE:-${LANG:-}}}}"
		LANG_CODE="${LANG_CODE%%.*}"
	fi

	[[ ! -f "/$caller_path/lang/strings-${LANG_CODE}" ]] &&
		LANG_CODE="${LANG_CODE%%_*}" # fallback from [country_region] to [country]

}

# shellcheck disable=SC2120
function lang_common_load_strings() {

	local caller_path; caller_path="$(dirname "${SOURCE_COMMON_CALLER:-BASH_SOURCE[1]}")"

	if [[ -z "${1:-}" ]]; then
		lang_common_set_lang_code "${caller_path}"
	else
		LANG_CODE="${1}"
	fi

	[[ "${LANG_CODE:2}" != "en" ]] &&
		. "$caller_path/lang/strings-en" # always load en

	# shellcheck disable=SC1090
	. "$caller_path/lang/strings-$LANG_CODE"
}

function echo_lang() {
	local format="$1"
	shift

	if [[ "$format" == *%* ]]; then
		if [[ "$format" == *%*%* ]]; then
			# shellcheck disable=SC2059
			printf "$format" "$@"
		else
			# shellcheck disable=SC2059
			printf "$format" "$*"
		fi
	else
		printf '%s' "$format" "$@"
	fi

	printf '\n'
}

lang_common_load_strings "${1:-}"