#!/bin/bash

declare __this_path; __this_path="$(dirname "${BASH_SOURCE[0]}")"
. "$__this_path/libs/log-lib"

declare logfile="/var/log/opkg-manager/startup.log"

init_logging_to_file "$logfile"
declare -i dry_run= 
[[ "${1:-}" == "--dry-run " ]] && dry_run=1

((dry_run)) && echo "dry run (not execiting stripts)"

execute_startup_script() {
  local script_path="${1}"
  ((dry_run)) && {
    echo "would execute... $script_path"
    return 1
  }

  log "***************************"
  log "executing... $script_path"
  "$script_path" >>"$logfile" 2>&1
  log "***************************"
  log " "
}

declare file=

while read -r file; do
  execute_startup_script "$file"
done < <(
    find /data -mindepth 2 -maxdepth 2 -type f -name '*rc-startup' \
    | awk -F/ '{print $NF "\t" $0}' \
    | sort \
    | cut -f2-
  )