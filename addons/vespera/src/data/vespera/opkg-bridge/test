#!/bin/bash
 
set -o nounset

declare command=${1:?"invalid command"}
shift

case "${command}" in
	test1)
		echo "test1" 
		;;
  test2)
    echo "test2"
    ;;
  test3)
    echo "test3"
    ;;
  test-loop)
    for i in $(seq 1 10); do
      echo "test-loop tick ${i}/10"
      sleep 0.5
    done
    ;;
  hello-world)
    echo "Hello World"
    ;;
  test-error-formatting)
    echo "info Preparing synthetic output"
    echo "success cached package index loaded"
    echo "warning cache metadata is stale"
    echo "Normal line after warning"
    echo "ERROR package install failed"
    echo "error unable to continue"
    echo "warning final cleanup needed"
    echo "success Finished synthetic output"
    ;;
  *)
    if [[ -n ${1:-} ]]; then
      echo "device: invalid command : ${1}" >&2
    fi
    ;;
esac