#!/usr/bin/env bash

set -o nounset

SERVICE="com.victronenergy.opkgmanager"

dbus_get() {
  dbus -y "$SERVICE" "$1" GetValue 2>/dev/null || true
}

dbus_set() {
  dbus -y "$SERVICE" "$1" SetValue "$2" >/dev/null
}

to_int() {
  local value="${1:-}"
  value="$(echo "$value" | sed -n 's/[^0-9-]*\(-\{0,1\}[0-9]\+\).*/\1/p' | head -n 1)"
  [[ -n "$value" ]] || value=0
  echo "$value"
}

to_string() {
  local value="${1:-}"
  value="${value#\"}"
  value="${value%\"}"
  value="${value#\'}"
  value="${value%\'}"
  echo "$value"
}

send_cancel() {
  local current
  current="$(to_int "$(dbus_get /Request/Cancel)")"
  dbus_set /Request/Cancel "$((current + 1))" || true
}

trap 'send_cancel' INT TERM

args_json="$(python3 - "$@" <<'PY'
import json
import sys
print(json.dumps(sys.argv[1:]))
PY
)"

dbus_set /Request/ArgsJson "$args_json"

start_value="$(to_int "$(dbus_get /Request/Start)")"
dbus_set /Request/Start "$((start_value + 1))"

last_stdout_seq="$(to_int "$(dbus_get /Event/StdoutSeq)")"
last_stderr_seq="$(to_int "$(dbus_get /Event/StderrSeq)")"
last_finished_seq="$(to_int "$(dbus_get /Event/FinishedSeq)")"

while true; do
  stdout_seq="$(to_int "$(dbus_get /Event/StdoutSeq)")"
  if (( stdout_seq != last_stdout_seq )); then
    line="$(to_string "$(dbus_get /Event/StdoutLine)")"
    [[ -n "$line" ]] && echo "$line"
    last_stdout_seq=$stdout_seq
  fi

  stderr_seq="$(to_int "$(dbus_get /Event/StderrSeq)")"
  if (( stderr_seq != last_stderr_seq )); then
    line="$(to_string "$(dbus_get /Event/StderrLine)")"
    [[ -n "$line" ]] && echo "$line" >&2
    last_stderr_seq=$stderr_seq
  fi

  finished_seq="$(to_int "$(dbus_get /Event/FinishedSeq)")"
  if (( finished_seq != last_finished_seq )); then
    exit_code="$(to_int "$(dbus_get /Result/ExitCode)")"
    exit "$exit_code"
  fi

  running="$(to_int "$(dbus_get /State/Running)")"
  if (( running == 0 )); then
    break
  fi

  read -r -t 0.1 _unused || true
done

exit_code="$(to_int "$(dbus_get /Result/ExitCode)")"
exit "$exit_code"