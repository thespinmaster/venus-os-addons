######################################
# expands the path to a full path
# does not follow symlinks, even for
# relative paths
# Arguments
# # $1 the path to expand
#######################################
core_lib_realpath_nosymlinks() { 
  realpath --no-symlinks "$([[ ${1:0:1} != "/" ]] && { 
        echo "$PWD/${1}"; return; };
        echo "${1}"; )"; 
  }

relative_path() { realpath --relative-to="${this_path}" "${1}"; }

#######################################
# List methods from a Bash script
#
# Usage:
#   core_utils_lib_list_methods_in_script <script> [mode] [comments]
#
# Arguments:
#   script    Path to the Bash script to inspect
#
#   mode      public   (default)  functions not starting with "_"
#             private              functions starting with "_"
#             all                  all functions
#
#   comments  with-comments        include comment blocks above functions
#             no-comments (default)
#
# Examples:
#   core_utils_lib_list_methods_in_script mylib.sh
#   core_utils_lib_list_methods_in_script mylib.sh private
#   core_utils_lib_list_methods_in_script mylib.sh all with-comments
#   core_utils_lib_list_methods_in_script --help
#######################################
core_lib_list_methods_in_script() {
  case "$1" in
    -h|--help|"")
      cat <<'EOF'
Usage:
  core_utils_lib_list_methods_in_script <script> [mode] [comments]

Arguments:
  script    Path to the Bash script to inspect

  mode:
    public    (default)  List public functions (no leading "_")
    private              List private functions (leading "_")
    all                  List all functions

  comments:
    with-comments        Include comment blocks above functions
    no-comments          (default)

Examples:
  core_utils_lib_list_methods_in_script mylib
  core_utils_lib_list_methods_in_script mylib private
  core_utils_lib_list_methods_in_script mylib all with-comments
EOF
      [[ -z "$1" ]] && return 1 || return 0
      ;;
  esac

  local script="$1"
  local mode="${2:-public}"
  local comments="${3:-no-comments}"

  [[ -f "$script" ]] || {
    echo "Error: file not found: $script" >&2
    return 1
  }

  awk -v mode="$mode" -v comments="$comments" '
    function should_print(name) {
      if (mode == "all") return 1
      if (mode == "public" && name !~ /^_/) return 1
      if (mode == "private" && name ~ /^_/) return 1
      return 0
    }

    function flush_comments() {
      if (comments == "with-comments" && comment_buf != "") {
        print comment_buf
      }
      comment_buf = ""
    }

    # Capture consecutive comment lines
    /^[[:space:]]*#/ {
      if (comment_buf == "")
        comment_buf = $0
      else
        comment_buf = comment_buf ORS $0
      next
    }

    # Blank line breaks comment association
    /^[[:space:]]*$/ {
      comment_buf = ""
      next
    }

    # name() {
    /^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\(\)[[:space:]]*\{/ {
      name = $1
      sub(/\(\)/, "", name)
      if (should_print(name)) {
        flush_comments()
        print name
        print ""   # spacer
      }
      next
    }

    # function name {
    /^[[:space:]]*function[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{/ {
      name = $2
      if (should_print(name)) {
        flush_comments()
        print name
        print ""
      }
      next
    }

    # Any other line resets comment buffer
    {
      comment_buf = ""
    }
  ' "$script"
}

[[ "${1:-}" = "core_lib_list_methods_in_script" ]] && { shift; core_lib_list_methods_in_script "$@"; }

