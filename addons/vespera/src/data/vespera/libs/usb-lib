#!/usr/bin/env bash
set -e

# Resolve the USB device id that backs a tty port.
# Args:
#   $1: tty port name under `/dev` (for example `ttyUSB0`).
#   $2: name of the output variable that will receive the USB device id.
# Outputs:
#   Sets the variable named by `$2` to a sysfs USB device id such as `1-1.4`.
__usb_get_device() {
  local port="$1"
  local -n out_usbdev=$2
  local path; path=$(readlink -f /sys/class/tty/"${port}"/device)
  # shellcheck disable=SC2034
  out_usbdev=$(basename "$(dirname "$(dirname "$path")")")
}

# Resolve a tty device name from a USB bus and device number.
# Args:
#   $1: USB bus number (for example `003`).
#   $2: USB device number (for example `002`).
# Outputs:
#   Prints the matching tty device name such as `ttyUSB0`.
usb_get_tty() {
  local bus="${1:-}"
  local device="${2:-}"
  local tty=

  [[ -n "$bus" ]] || { echo "arg1: Bus number missing"; return 1; }
  [[ -n "$device" ]] || { echo "arg2: Device number missing"; return 1; }

  tty=$(udevadm info --query=path --name="/dev/bus/usb/${bus}/${device}" \
    | xargs -I% find "/sys%" -path '*/tty*' -name 'device' \
    | xargs dirname 2>/dev/null \
    | xargs basename 2>/dev/null)

  [[ -n "$tty" ]] || { echo "port not found" >&2; return 1; }
  echo "$tty"
}

# Disconnect a USB device by unbinding the driver for the tty port.
# Args:
#   $1: tty port name under `/dev` (for example `ttyUSB0`).
# Outputs:
#   Prints status information and the USB device id to use for rebind.
usb_disconnect() {
  local port="$1"
  local usbdev=

  __usb_get_device "$port" usbdev
  [[ -z $usbdev ]] && { echo "ERROR: Device not found"; return 1; }

  echo "$usbdev" > /sys/bus/usb/drivers/usb/unbind
  sleep 1
  if ls -l "/dev/$port" 2>/dev/null; then
    echo "disconnect failed"
  else
    echo "disconnect succeeded"
  fi
  echo "reconnect with: usb-device connect $usbdev"
}

# Connect a USB device by binding it again using its USB device id.
# Args:
#   $1: USB device id from sysfs (for example `1-1.4`).
# Outputs:
#   Prints the device id and the first matching tty port after connect.
usb_connect() {
  local usbdev="$1"

  test -d "/sys/bus/usb/devices/$usbdev" || { echo "ERROR: Device not found: $usbdev" >&2; return 1; }

  echo "$usbdev"
  echo "$usbdev" > /sys/bus/usb/drivers/usb/bind
  sleep 1

  local port=
  local p=
  for t in /sys/bus/usb/devices/$usbdev*/tty*; do
    p=$(basename "$t")
    if [[ -e "/dev/$p" ]]; then
      port=$p
      break
    fi
  done

  echo "$port"
}

# Reconnect a USB tty device by disconnecting and then reconnecting it.
# Args:
#   $1: tty port name under `/dev` (for example `ttyUSB0`).
# Outputs:
#   Prints whether the device was visible again after reconnect.
usb_reconnect() {
  local port="$1"
  local usbdev=

  __usb_get_device "$port" usbdev
  [[ -z $usbdev ]] && { echo "ERROR: Device not found"; return 1; }

  echo "$usbdev" > /sys/bus/usb/drivers/usb/unbind 2>/dev/null
  sleep 2
  echo "$usbdev" > /sys/bus/usb/drivers/usb/bind  2>/dev/null
  if ls -l "/dev/$port" 2>/dev/null; then
    echo "reconnect succeeded"
    return 0
  else
    echo "reconnect failed"
    return 1
  fi
}
usb_get_prop() {
  udevadm info --query=property --name="$1" | sed -n "s/^$2=//p"
}

usb_get_props() {
  local devpath="$1"
  local props prop
  shift
 
  props=$(udevadm info --query=property --name="$devpath" || echo "")
  [[ -z "$*" ]] && return "$props"

  for prop in "$@"; do
    printf '%s\n' "$props" | sed -n "s/^${prop}=//p"
  done
}

# Validate that a required positional argument was provided.
# Args:
#   $1: the value to validate.
# Exits:
#   Exits with status 1 if the argument is empty.
__validatePort() {
  if [[ -z "${1:-}" ]]; then
    echo "arg2: Usb port missing"
    exit 1
  fi
}

usb_help() {
  cat <<'EOF'
A helper for connecting/disconnecting USB devices.

Usage:
  usb-device disconnect ttyUSB0
      Disconnect a USB device. Simulates unplugging the device.
  usb-device connect 1-1.4
      Connect a device using its USB device id.
  usb-device reconnect ttyUSB0
      Disconnect and reconnect a USB device. Simulates re-plugging it.
  usb-device get-tty 003 002
      Resolve the tty from the bus:device values shown by `lsusb`.
  usb-device list [ttyUSB0]
      Show all `udevadm` properties for one tty, or all USB tty devices.
    usb-device get-prop ttyUSB0 ID_MODEL [ID_VENDOR ...]
      Gets one or more udev properties for the given tty device.
EOF
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  case "${1:-}" in
    --help|help|"")
      usb_help
      ;;
    get-tty)
      shift
      usb_get_tty "${1}" "${2}"
      ;;
    list)
      shift
      usb_list "${1:-}"
      ;;
    disconnect|remove)
      __validatePort "${2:-}"
      shift
      usb_disconnect "${1}"
      ;;
    connect|add)
      __validatePort "${2:-}"
      shift
      usb_connect "${1}"
      ;;
    reconnect|reset|restart)
      __validatePort "${2:-}"
      shift
      usb_reconnect "${1}"
      ;;
    usb_get_props)
      __validatePort "${2:-}"
      shift
      usb_get_props "$@"
      ;;
    get-prop)
      __validatePort "${2:-}"
      shift
      usb_get_prop "$@"
      ;;
    *)
      echo "ERROR: Unknown command: ${1}" >&2
      usb_help >&2
      exit 1
      ;;
  esac
fi