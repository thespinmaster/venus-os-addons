#!/bin/bash

# shellcheck disable=SC2034

########################################################
# Pre set values, set by installer-common

# The version of installer-common
# INSTALLER_VERSION

# The action the insatller is performing
# PACKAGE_ACTION
	# Valid $PACKAGE_ACTION's
	# install|upgrade-install|configure|dev-install
	# remove|upgrade-remove|dev-remove

# Set to the current verson being installed
# PACKAGE_VERSION_NEW=

# Set to the version currently installed, when upgrading
# PACKAGE_VERSION_CURRENT=

# Set when the installer in running from the Venus OS UI
# RUNNING_FROM_GUI=
########################################################

########################################################
# Installer settings

# The script to add to /data/rc.local
# It is very rare to need to add custom code to
# RC_LOCAL_SCRIPT | RCS_LOCAL_SCRIPT
# The rc.local-startup stript added my the opkg-manager
# looks for a numeric "1-rc-startup" file in the install folder.
# and executes that script, meaning rc.local does not need editing
: <<'Example'
RC_LOCAL_SCRIPT='
# $PACKAGE_NAME (do not edit)
/data/$PACKAGE_NAME/rc.local-startup
'
Example

# The script to add to /data/rcS.local
# See notes above for RC_LOCAL_SCRIPT
# RCS_LOCAL_SCRIPT=

# optional, when empty package name is taken from the base directory's name
# PACKAGE_NAME=

# Dbus settings to add/remove:
# PACKAGE_DBUS_SETTINGS=
: <<'Example'
	PACKAGE_DBUS_SETTINGS='{"path":"/Settings/[PackageName]/[ValueName]", "default":"[SomeValue], "min":0, "max":1}
		# comments are allowed
		{"path":"/Settings/[PackageName]/[ValueName2]", "default":0, "min":0, "max":1}'
Example

########################################################
# Installer settings - Custom Usb Serial device settings

# These are all required when registering a service for use as a custom USB serial device
# The the name dbus key used to store the PACKAGE_DEVICE_ values
# PACKAGE_DEVICE_KEY=

# The name of the service/driver that runs when the device is added
# PACKAGE_DEVICE_SERVICE_NAME=

# A UI friendly name name of the device to display
# PACKAGE_DEVICE_DISPLAY_NAME=
########################################################

# An array of services to run (dont include custom USB serial device services here)
#PACKAGE_SERVICES=()

# The name of the gui-v2 to register
# when including a gui-v2 json plugin file. the file should be added to the root of
# the application i.e. /data/[app]/[plugin name].json
# the installer will move the addin to the correct location end of the install.
# This is so the UI is not interupted mid way through the install.
#TODO convert to an array
#PACKAGE_GUI_V2_PLUGIN_NAME=

# Set to 1 to restart the UI/UI releated services
# note: this is also set by installer-common
# RESTART_GUI=

# Custom gui-v1 menus to 'inject' into the settings pages
# the first part of the path is the name of page to add the new page to:
# [existing page]/[new page]
# These names are the qml file page names with the .qml extension removed.
: <<'Example'
	PACKAGE_CUSTOM_MENUS=(
		PageSettings/OpkgPageSettingsSubMenu
		PageSettingsDisplay/OpkgPageSettingsDisplaySubMenu
		PageMain/PageSettings
	)
Example


########################################################
# Valid callback functions
	# pre_remove
	# post_remove
	# finalize_remove - called after opkg has finished
	#
	# pre_install
	# post_install
	# finalize_install - called after opkg has finished
: <<'Example'
post_install() {
	' do additional install actions
}
Example

########################################################

####################################################
# REQUIRED to run the installer.
# source installer-common "$@"
