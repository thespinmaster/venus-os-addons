#!/bin/bash

set -o nounset

# Adds one or more items to a JSON array if they are not already present.
#
# Args:
#   $1: JSON array string (for example: ["a","b"]); empty/invalid input is treated as []
#   $2..: Items to add (supports empty strings and multiple items)
#
# Output:
#   Writes the updated compact JSON array to stdout.
json_lib_ary_add_unique_items() {
	local json_array="${1:-[]}"
	shift || true

	python3 - "$json_array" "$@" <<'PY'
import json
import sys

raw = sys.argv[1] if len(sys.argv) > 1 else "[]"
items = sys.argv[2:]

try:
	parsed = json.loads(raw) if raw.strip() else []
except Exception:
	parsed = []

if not isinstance(parsed, list):
	parsed = []

for item in items:
	if item.strip() and item not in parsed:
		parsed.append(item)

print(json.dumps(parsed, separators=(",", ":")))
PY
}

# Removes one or more items from a JSON array.
#
# Args:
#   $1: JSON array string (for example: ["a","b"]); empty/invalid input is treated as []
#   $2..: Items to remove (supports empty strings and multiple items)
#
# Output:
#   Writes the updated compact JSON array to stdout.
json_lib_ary_remove_items() {
	local json_array="${1:-[]}"
	shift || true

	python3 - "$json_array" "$@" <<'PY'
import json
import sys

raw = sys.argv[1] if len(sys.argv) > 1 else "[]"
items = sys.argv[2:]

try:
	parsed = json.loads(raw) if raw.strip() else []
except Exception:
	parsed = []

if not isinstance(parsed, list):
	parsed = []

for item in items:
	parsed = [value for value in parsed if value != item]

print(json.dumps(parsed, separators=(",", ":")))
PY
}

