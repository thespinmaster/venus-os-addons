#!/usr/bin/env bash
# shellcheck disable=SC2034

set -o nounset

readonly INSTALLER_VERSION=1.0
# install path without the package name
PACKAGE_INSTALL_DIR="$(dirname "${0}")"
PACKAGE_INSTALL_DIR="$(cd "${PACKAGE_INSTALL_DIR}/../.." && pwd)"
PACKAGE_ACTION="${1}"
PACKAGE_INSTALLER_FILE="${2}"
VESPERA_WORKING_DIR="${3}"
VESPERA_VERBOSITY="${4}"
PACKAGE_NAME="${PACKAGE_INSTALLER_FILE##*/}"; PACKAGE_NAME="${PACKAGE_NAME%.*}"
set --

[[ -z "${PACKAGE_ACTION}" ]] && { echo "CRITICAL: ACTION not set. Usage: <action> [installer-source]"; exit 1; }
[[ ! -f "$PACKAGE_INSTALLER_FILE" ]] && { echo "CRITICAL: INSTALLER_FILE not found: $PACKAGE_INSTALLER_FILE"; exit 1; }
[[ ! -d "$VESPERA_WORKING_DIR" ]] && { echo "CRITICAL: VESPERA_WORKING_DIR not found: $VESPERA_WORKING_DIR"; exit 1; }
[[ -z "${PACKAGE_NAME:-}" ]] && { echo "CRITICAL: PACKAGE_NAME not set"; exit 1; }

# shellcheck disable=SC1090
source "$PACKAGE_INSTALLER_FILE"

# install path with the package name
PACKAGE_DATA_INFO_DIR="$(dirname "$(realpath "${PACKAGE_INSTALLER_FILE}")")"
PACKAGE_DBUS_SETTINGS="${PACKAGE_DBUS_SETTINGS-}"
PACKAGE_DBUS_NAME="${PACKAGE_DBUS_NAME:-${PACKAGE_NAME//[ -]/_}}"
PACKAGE_CUSTOM_OVERVIEW_PAGES="${PACKAGE_CUSTOM_OVERVIEW_PAGES-}"
PACKAGE_CUSTOM_NAV_PAGES="${PACKAGE_CUSTOM_NAV_PAGES-}"
PACKAGE_CUSTOM_MENUS="${PACKAGE_CUSTOM_MENUS-}"
PACKAGE_DEVICES="${PACKAGE_DEVICES-}"
PACKAGE_VERSION_NEW=
PACKAGE_VERSION_CURRENT=
PACKAGE_DBUS_LIST_FILE=

RUNNING_FROM_GUI=
FIRMWARE_CHANGED=

RC_LOCAL_SCRIPT="${RC_LOCAL_SCRIPT-}"
RCS_LOCAL_SCRIPT="${RCS_LOCAL_SCRIPT-}"

# shellcheck source=/data/dev/addons/vespera/src/data/apps/available/vespera/libs/source-lib
source "${VESPERA_ROOT:-}$PACKAGE_INSTALL_DIR/vespera/libs/source-lib"

__try_call() {
	local call_method="${1}"
	if declare -F "${call_method}" >/dev/null; then
		shift
		${call_method} "$@"
	fi
}

installer_lib_get_patch_file_list() {
	local file="${1}"
	awk '
		{
			sub(/[[:space:]]*#.*$/, "", $0)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
			if ($0 == "") next
			print
		}
	' "$file" | sed -n '/^@openfile/{n;/^====$/!d;n;p;}'
}

installer_lib_log_verbose2() { ((VESPERA_VERBOSITY>1)) }
installer_lib_log_verbose3() { ((VESPERA_VERBOSITY>2)) }
installer_lib_log_verbose4() { ((VESPERA_VERBOSITY>3)) }


installer_lib_phase_sync_custom_nav_pages() {
	local action="${1:-}"
	[[ -n "${PACKAGE_CUSTOM_NAV_PAGES:-}" ]] || return 0
	[[ "$action" == "add" || "$action" == "remove" ]] || return 0

	local pages
	# shellcheck disable=SC2086
	pages=$(printf "%s " $PACKAGE_CUSTOM_NAV_PAGES)
	pages="${pages% }"
	installer_dbus_lib_nav_pages_sync "$action" "$PACKAGE_DBUS_NAME" "$pages"
}

installer_lib_is_upgrade() {
	[[ $PACKAGE_ACTION == "upgrade-remove" || $PACKAGE_ACTION == "upgrade-install" || $PACKAGE_ACTION == "upgrade-remove-post" ]]
}

installer_lib_is_remove() {
	[[ $PACKAGE_ACTION == "remove" || $PACKAGE_ACTION == "upgrade-remove" || $PACKAGE_ACTION == "upgrade-remove-post" || $PACKAGE_ACTION == "remove-post" ]]
}

installer_lib_update_install_list() {
	# + installed (not enabled)
	# * enabled
	local flag

	if installer_lib_is_remove; then
		installer_lib_is_upgrade && return
		flag="remove"
	elif installer_lib_is_upgrade; then
		[[ -L "/data/apps/enabled/$PACKAGE_NAME" ]] && flag="enabled" || flag="disabled"
	else
		flag="enabled"
	fi

	echo "$PACKAGE_NAME $flag" >> "$VESPERA_WORKING_DIR/$VESPERA_INSTALL_STATE_FILE"
	installer_lib_log_verbose2 && echo "Appending $PACKAGE_NAME $flag-> $VESPERA_WORKING_DIR/$VESPERA_INSTALL_STATE_FILE"
}

installer_lib_initialize() {

	addsource "conf/vespera.conf" 2>/dev/null ||
	addsource "conf-default/vespera.conf"

	addsource "libs/lang-lib" "$PACKAGE_INSTALL_DIR/vespera"
	addsource "libs/installer-dbus-lib"

	PACKAGE_DBUS_LIST_FILE="$VESPERA_DATA_DIR/info/$PACKAGE_NAME.dbus-list"

	[[ -f /var/lock/vespera-gui ]] && RUNNING_FROM_GUI=1 || RUNNING_FROM_GUI=0
	[[ -f "$VESPERA_WORKING_DIR/$VESPERA_VENUS_FIRMWARE_CHANGED_FILE" ]] && FIRMWARE_CHANGED=1 || FIRMWARE_CHANGED=0

	if [[ $PACKAGE_ACTION == "configure" ]]; then
		if [[ $FIRMWARE_CHANGED == 1 ]]; then
			PACKAGE_ACTION="firmware-changed"
		else
			PACKAGE_VERSION_NEW="$(awk '/Version:/ {print $2}' "${PACKAGE_DATA_INFO_DIR}/${PACKAGE_NAME}".control 2>/dev/null)"
			PACKAGE_VERSION_CURRENT="$(vespera status "$PACKAGE_NAME" 2>/dev/null | awk '/Version:/ {print $2}' 2>/dev/null)"
			[[ -z "$PACKAGE_VERSION_CURRENT" ]] && PACKAGE_ACTION="install" || PACKAGE_ACTION="upgrade-install"

		fi
	elif [[ "$PACKAGE_ACTION" == "upgrade" ]]; then
		PACKAGE_ACTION="upgrade-remove"
	fi

	if ! installer_lib_is_remove  && installer_lib_is_upgrade; then
		echo_lang "$LANG_REMOVED_PREVIOUS_INSTALL_UPGRADING_NOW"
	fi

	if installer_lib_is_upgrade && installer_lib_is_remove; then
		[[ -f "$PACKAGE_DBUS_LIST_FILE" ]] &&
		cp "$PACKAGE_DBUS_LIST_FILE" "$VESPERA_WORKING_DIR/${PACKAGE_DBUS_LIST_FILE##*/}.prev"
	fi

	installer_lib_log_verbose2 && {
		echo "PACKAGE_ACTION=$PACKAGE_ACTION"
		echo "FIRMWARE_CHANGED=$FIRMWARE_CHANGED"
		echo "PACKAGE_DATA_INFO_DIR=$PACKAGE_DATA_INFO_DIR"
		echo "PACKAGE_VERSION_NEW=$PACKAGE_VERSION_NEW"
		echo "PACKAGE_VERSION_CURRENT=$PACKAGE_VERSION_CURRENT"
		echo "PACKAGE_INSTALL_DIR=$PACKAGE_INSTALL_DIR"
		echo "PACKAGE_DBUS_LIST_FILE=$PACKAGE_DBUS_LIST_FILE"
		echo_lang "$LANG_LANGUAGE_ARG1" "$LANG_CODE"
	}
}
