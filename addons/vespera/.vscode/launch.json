	"version": "0.2.0",
	"configurations": [
		{
			"name": "opkg-manager (folder-local)",
			"type": "debugpy",
			"request": "launch",
			"python": "/usr/bin/python",
			"cwd": "${workspaceFolder}",
			"program": "${workspaceFolder}/src/opt/victronenergy/opkg-manager/__main__.py",
			"console": "integratedTerminal",
			"justMyCode": true,
			"stopOnEntry": true,
			"env": {
				"OPKG_MANAGER_LOG_LEVEL": "DEBUG"
			},
			"args": []
		}
	]
}