#!/bin/bash

set -e

[[ -f /data/apps/vespera/vespera ]] && exit 0

#if vespera is not installed manualy add start up code to rc.local

rc_local="/data/rc.local"
mount_all_line='[[ ! -f /data/apps/vespera/vespera ]] && /data/apps/mount-shares/2-rc-startup'

# Ensure rc.local exists before we try to append to it.

if [[ ! -f "$rc_local" ]]; then
	touch "$rc_local"
	chmod +x "$rc_local"
fi

# Add the mount-all line only once.
if ! grep -Fqx "$mount_all_line" "$rc_local"; then
	echo "$mount_all_line" >> "$rc_local"
fi

/data/apps/mount-shares/mount-lib "mount-all"