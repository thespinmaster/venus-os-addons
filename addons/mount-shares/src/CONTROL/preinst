#!/bin/bash

set -e

rc_local="/data/rc.local"
mount_all_line='[[ ! -f /data/apps/vespera/vespera ]] && /data/apps/mount-shares/2-rc-startup'

# Remove the mount-all startup line if present.
if [[ -f "$rc_local" ]]; then
	tmp_file="$(mktemp)"
	grep -Fvx "$mount_all_line" "$rc_local" > "$tmp_file" || true
	mv "$tmp_file" "$rc_local"
fi
