# Example config for blind-install
# One directive per line.
# Blank lines and comment lines are ignored.

# Feed format:
# feed <feed-name> <feed-url>
feed vespera-release https://thespinmaster.github.io/venus-os-addons/feeds/release/vespera

# Package format:
# package <action> [args ...] <package-name>
package install vespera
package install --force-reinstall dbus-inetbox