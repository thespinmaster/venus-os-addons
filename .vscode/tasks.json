{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "opkgPackage",
      "type": "promptString",
      "description": "Package(s) (all or vespera mount-shares themer etc)",
      "default": ""
    },
    {
      "id": "opkgPromoteFeed",
      "type":"pickString",
      "description": "Packages to promote (addons or vespera)",
      "options": ["all", "vespera", "addons"],
      "default": "all"
		},
		{
			"id": "bashCountPath",
			"type": "promptString",
			"description": "Path to scan for bash scripts",
			"default": "${workspaceFolder}"
		},
		{
			"id": "bashCountIncludeComments",
			"type": "pickString",
			"description": "Include full-line comments in count?",
			"options": ["no", "yes"],
			"default": "no"
    }
  ],
  "tasks": [
		{
			"label": "opkg build packages (develop)",
			"type": "shell",
			"command": "${workspaceFolder}/tasks/build-packages",
			"args": [
				"--develop-only",
				"${input:opkgPackage}"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Develop-only build with prompt for package."
		},
		{
			"label": "opkg build packages (develop) all",
			"type": "shell",
			"command": "${workspaceFolder}/tasks/build-packages",
			"args": [
				"--develop-only",
				"all"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Develop-only build with prompt for package."

		},
		{
			"label": "Promote develop feed to release",
			"type": "shell",
			"command": "${workspaceFolder}/tasks/build-packages",
			"args": [
				"--promote",
				"${input:opkgPromoteFeed}"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Promote develop feeds into release feeds."
		},
		{
			"label": "cleanup vscode server installs",
			"type": "shell",
			"command": "${workspaceFolder}/tasks/cleanup-vscode-server",
			"problemMatcher": [],
			"group": "none",
			"presentation": {
				"reveal": "always"
			},
			"detail": "Removes all but the latest VS Code server install from ~/.vscode-server/bin (dry run by default). Remove --dry-run to actually delete."
		},
		{
			"label": "all tests",
			"type": "shell",
			"problemMatcher": [],
			"command": "bash ${workspaceFolder}/tasks/run-tests",
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"detail": "Finds and runs tests in all folders."
		},
		{
			"label": "all tests (nearest tests folder)",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/run-tests-nearest",
			"args": [
				"${fileDirname}"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false
			},
			"detail": "Walks up from current file/folder, finds the nearest tests folder, and runs all tests there."
		},
		{
			"label": "Bash -n current file",
			"type": "shell",
			"command": "bash",
			"args": [
				"-n",
				"${file}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Count bash lines under path",
			"type": "shell",
			"command": "${workspaceFolder}/tasks/count-bash-lines",
			"args": [
				"${input:bashCountPath}",
				"--include-comments",
				"${input:bashCountIncludeComments}"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Count lines in bash scripts under a given path (comments excluded by default)."
		},
		{
			"label": "run bash script",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/run-current-tests",
			"args": [
				"${workspaceFolder}/addons/vespera/tests/serial-device-installer-tests"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false,
				"preserveTerminalName": false,
				"echo": false
			}
		},
		{
			"label": "tests for current file",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/run-tests-current-file",
			"args": [
				"${file}"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false,
				"preserveTerminalName": false,
				"echo": false
			},
			"detail": "Runs the matching test file for the active file, or the active test file itself."
		},
		{
			"label": "build qmlplugin",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/build-qmlplugin",
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false
			}
		},
		{
			"label": "build qmlplugin qt6",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/build-qmlplugin",
			"args": [
				"qt6"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false
			}
		},
		{
			"label": "build qmlplugin armhf rpi4",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/build-qmlplugin",
			"args": [
				"armhf"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false
			}
		},
		{
			"label": "build qmlplugin armhf qt6",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/build-qmlplugin",
			"args": [
				"armhf",
				"qt6"
			],
			"presentation": {
				"panel": "dedicated",
				"reveal": "always",
				"focus": true,
				"showReuseMessage": false,
				"clear": true,
				"close": false
			}
		},
		{
			"label": "build opkg-json-indexer armhf",
			"type": "shell",
			"problemMatcher": [],
			"command": "${workspaceFolder}/tasks/build-opkg-json-indexer",
			"args": [
				"armhf"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"detail": "Compile opkg-json-indexer with armhf toolchain and write output to service-commands/opkg-json-indexer"
		},
		{
			"label": "cleanup opkg develop feed",
			"type": "shell",
			"command": "bash ${workspaceFolder}/tasks/build-packages",
			"args": [
				"--clean-develop"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Clears the opkg develop feeds folder used by package builds."
		},
		{
			"label": "run all venus-os tests",
			"type": "shell",
			"command": "bash ${workspaceFolder}/tasks/run-tests",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Restart Venus-GUI Service",
			"type": "shell",
			"command": "svc -t /service/gui",
			"presentation": {
				"reveal": "never",
				"panel": "shared",
				"close": false
			},
			"problemMatcher": []
		},
		{
			"label": "Build vespera Blind Install",
			"type": "shell",
			"command": "bash addons/vespera/blind-install/build_tgz",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Decompress IPK",
			"type": "process",
			"command": "${workspaceFolder}/tasks/decompress-ipk",
			"args": [
				"${file}"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared",
				"showReuseMessage": false,
				"clear": true
			},
			"problemMatcher": [],
			"detail": "Extract selected/open .ipk into sibling folder and unpack control/data tarballs."
		}
	]
}