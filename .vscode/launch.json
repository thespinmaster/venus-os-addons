{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",

    "configurations": [
        {
            "type": "bashdb",
            "presentation": { "group": "bash" },
            "request": "launch",
            "name": "Bash - active file",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "terminalKind": "integrated",

            "args": []
        },

        {
            "type": "bashdb",
            "presentation": { "group": "bash" },
            "request": "launch",
            "name": "Bash - defined script",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/addons/vespera/tests/serial-device-installer-tests",
            "terminalKind": "integrated",
            "args": []
        },
        {
            "name": "Python - active file",
            "presentation": { "group": "python"},
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/bin/python",
            "cwd": "${fileDirname}",
            "program": "${file}",
            "console": "integratedTerminal"
        },

        {
            "name": "dbus-inetbox (ttyUSB0)",
            "presentation": { "group": "inetbox" },
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/bin/python",
            "cwd": "${workspaceFolder}/addons/dbus-inetbox/src/opt/victronenergy/dbus-inetbox",
            "program": "__main__.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": ["--serial", "/dev/ttyUSB0",
                "--debug_lin"]
        },
        {
					"name": "vespera",
					"presentation": { "group": "vespera"},
					"type": "debugpy",
					"request": "launch",
					"python": "/usr/bin/python",
                    "cwd": "${workspaceFolder}",
					"program": "${workspaceFolder}/addons/vespera/src/opt/victronenergy/vespera/__main__.py",
					"console": "integratedTerminal",
                    "stopOnEntry": false,
                    "env": {
                        "VESPERA_LOG_LEVEL": "DEBUG"
                    },
                    "args": []
			},
        {
            "name": "dbus-ne-shunt",
            "presentation": { "group": "dbus-ne-shunt"},
            "type": "debugpy",
            "request": "launch",
            "python": "/usr/bin/python",
            "program": "${workspaceFolder}/addons/dbus-ne-shunt/src/opt/victronenergy/dbus-ne-shunt/__main__.py",
            "console": "integratedTerminal",
            "args": ["--serial", "/dev/ttyUSB0", "--debug"]
        },
        {
            "type": "debugpy",
            "presentation": { "group": "python" },
            "request": "launch",
            "name": "Python - opkg-make-index",
            "python": "/usr/bin/python",
            "cwd": "${workspaceFolder}/feeds/vespera",
            "program": "${workspaceFolder}/tooling/opkg-utils/opkg-make-index",
            "args": ["-p", "Packages", "./"]
        },
    ],
    "compounds": [
        {
            "name": "dbus-inetbox-orig + lin-playback",
            "presentation": { "group": "inetbox" },
            "configurations": [
                "LIN Device Player",
                "Inetbox-orig (SIM)"
            ],
            "stopAll": true
        },
        {
            "name": "dbus-inetbox-async + lin-playback",
            "presentation": { "group": "inetbox" },
            "configurations": [
                "LIN Device Player",
                "Inetbox-async (SIM)"
            ],
            "stopAll": true
        }
    ],

}