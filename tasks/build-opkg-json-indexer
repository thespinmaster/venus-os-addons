#!/usr/bin/env bash
set -euo pipefail

##############################################################
# Build the opkg-json-indexer C binary for opkg list parsing.
# This replaces the Python helper to improve UI startup speed.
#
# The binary is compiled standalone with no Qt/heavy dependencies.
# Supports: armhf (Raspberry Pi), x86_64 (development/testing)
#
# Args:
#   armhf     - Cross-compile for ARM (Raspberry Pi / Venus OS devices)
#   (default) - Compile for current host architecture
##############################################################

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
bridge_src="$repo_root/addons/vespera/src-external/opkg-json-indexer"
output_dir="$repo_root/addons/vespera/src/data/apps/vespera/opkg"
output_bin="$output_dir/opkg-json-indexer"

armhf_build=false

for arg in "$@"; do
    case "$arg" in
        armhf)
            armhf_build=true
            ;;
        *)
            echo "Unknown argument: $arg" >&2
            exit 1
            ;;
    esac
done

cd "$bridge_src" || exit 1
mkdir -p "$output_dir"

if $armhf_build; then
    echo "Building opkg-json-indexer for armhf (Raspberry Pi)..."
    arm-linux-gnueabihf-gcc \
        -O2 -Wall -Wextra -o \
        "$output_bin" opkg-json-indexer.c
else
    echo "Building opkg-json-indexer for native architecture..."
    gcc \
        -O2 -Wall -Wextra -o \
        "$output_bin" opkg-json-indexer.c
fi

if [[ -f "$output_bin" ]]; then
    chmod +x "$output_bin"
    echo "✓ opkg-json-indexer binary created successfully"
    file "$output_bin"
else
    echo "✗ Failed to create opkg-json-indexer binary"
    exit 1
fi
