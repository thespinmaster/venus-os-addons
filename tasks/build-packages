#!/usr/bin/env bash

set -euo pipefail

####################################################################
# Creates all (default) the opkg packages in the folders
#   ../addons
# Ignored files/folders
#   .bak, .git, .tmp, /tests, -v[0-9], .old, .venv
# All files are develop (copied to ) ../.build and built from there.
# Symlinks are preserved as symlinks (do not dereference targets during copy)
# Args:
#   Arg1:"all" (default): Builds all folders under under services & utils.
#   Arg[n]: Or a list of folders under services or utils to build
# Options:
#   --develop-only             Build and index into develop folders only (stamps version with +~YYMMDD.HHMM)
#   --promote                  Promote develop feed to release feed
#   --clean-develop            Remove all contents from the develop feeds folder
####################################################################

command -v opkg-build >/dev/null 2>&1 || { echo "ERROR: opkg-build not installed"; exit 1; }
command -v opkg-make-index >/dev/null 2>&1 || { echo "ERROR: opkg-make-index not installed"; exit 1; }
command -v rsync >/dev/null 2>&1 || { echo "ERROR: rsync not installed"; exit 1; }

this_path="$(dirname "${BASH_SOURCE[0]}")"

declare -a build_items=()
declare -a folders=("../addons")
declare -a cli_build_args=()
declare -a normalized_cli_build_args=()
declare pwd_old="$PWD"
declare -A update_feeds=()
declare promote_target=

declare -i develop_only=0
declare -i promote_only=0
declare -i clean_develop_only=0
declare -i all_mode=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] [all|<package> ...]

Options:
  --develop-only           Build and index packages in develop only.
                           Version is stamped as MAJOR.MINOR.PATCH~dYYMMDD.HHMM
                           Old develop packages for the same name are removed before placing the new one.
  --promote                Promote develop feed to release feed
  --clean-develop          Remove all contents from the develop feeds folder
  -h, --help               Show this help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --develop-only)
      develop_only=1
      ;;
    --promote)
      promote_only=1
      ;;
    --clean-develop)
      clean_develop_only=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      cli_build_args+=("$@")
      break
      ;;
    *)
      cli_build_args+=("$1")
      ;;
  esac
  shift
done

# Normalize positional package arguments so both of these forms work:
#   make-packages vespera mount-shares
#   make-packages "vespera mount-shares"
# This is especially useful for task runners that pass prompt input as one arg.
for arg in "${cli_build_args[@]}"; do
  if [[ "$arg" =~ [[:space:]] ]]; then
    read -r -a _split <<< "$arg"
    normalized_cli_build_args+=("${_split[@]}")
  else
    normalized_cli_build_args+=("$arg")
  fi
done

cli_build_args=("${normalized_cli_build_args[@]}")

(( develop_only == 0 || promote_only == 0 )) || {
  echo "ERROR: --develop-only and --promote cannot be combined" >&2
  exit 1
}

(( clean_develop_only == 0 || develop_only == 0 )) || {
  echo "ERROR: --clean-develop cannot be combined with --develop-only" >&2
  exit 1
}

(( clean_develop_only == 0 || promote_only == 0 )) || {
  echo "ERROR: --clean-develop cannot be combined with --promote" >&2
  exit 1
}

cd "$this_path" || exit 1

this_path="."
feeds_root="../feeds"
develop_root="${feeds_root}/develop"
release_root="${feeds_root}/release"
test_feed_name="test-feed"
test_feed_root="${feeds_root}/${test_feed_name}"

feed_name_for_package() {
  local name="$1"
  if [[ "$name" == test-* ]]; then
    echo "$test_feed_name"
  elif [[ "$name" == "vespera" ]]; then
    echo "vespera"
  else
    echo "addons"
  fi
}

feed_path_for_name() {
  local feed_name="$1"
  if [[ "$feed_name" == "$test_feed_name" ]]; then
    echo "$test_feed_root"
  else
    echo "${develop_root}/${feed_name}"
  fi
}

build_feed_index() {
  local feed_path="${1}"
  (cd "$feed_path" && opkg-make-index -p Packages ./ 1>/dev/null)
  echo "feed ${feed_path} updated"
}

build_feed_indexes() {
  # Loop through all values in update_feeds and call build_feed_index
  for feed_path in "${update_feeds[@]}"; do
    build_feed_index "$feed_path"
  done
}

folder_has_newer_file_than_ipk() {
  local ipk_path="$1"
  local base_folder="$2"

  find "$base_folder" -type f -newer "$ipk_path" -print -quit | grep -q .
}

newest_ipk_for_package() {
  local feed_path="$1"
  local package_name="$2"

  [[ -d "$feed_path" ]] || return 0

  find "$feed_path" -maxdepth 1 -type f -name "${package_name}_*.ipk" -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-
}

build_package_if_needed() {
  local pkg_root="$1"
  local name
  local feed_name
  local feed_path
  local newest_ipk
  local source_path
  local source_is_newer
  local run_build_all

  name="$(basename "$pkg_root")"
  run_build_all=1

  if (( all_mode == 1 )); then
    feed_name="$(feed_name_for_package "$name")"
    feed_path="$(feed_path_for_name "$feed_name")"
    newest_ipk="$(newest_ipk_for_package "$feed_path" "$name")"

    source_is_newer=0
    run_build_all=0
    for source_path in "$pkg_root/src" "$pkg_root/src-external"; do
      [[ -d "$source_path" ]] || continue
      if [[ -z "$newest_ipk" ]] || folder_has_newer_file_than_ipk "$newest_ipk" "$source_path"; then
        source_is_newer=1
        [[ "$source_path" == "$pkg_root/src-external" ]] && run_build_all=1
        break
      fi
    done

    if [[ $source_is_newer -eq 0 ]]; then
      echo "skipping ${name}: source is not newer than newest ipk"
      return 10
    fi
  fi

  build_package "$pkg_root" "$run_build_all"
}

resolve_build_items() {
  declare -i found=0
  local i
  local f

  if [[ ${#cli_build_args[@]} -eq 0 || "${cli_build_args[0]}" == "all" ]]; then
    all_mode=1
    echo "cur dir: $PWD"
    mapfile -t build_items < <(
      for folder in "${folders[@]}"; do
        find "$folder" -mindepth 1 -maxdepth 1 ! -name '*.old' -type d -exec realpath {} +
      done
    )

	if [[ ${#build_items[@]} -eq 0 ]]; then
		echo "nothing to build"
		exit 0
	fi
		return 0
  fi

  if [[ "${cli_build_args[0]}" == "package" ]]; then
    [[ -n "${cli_build_args[1]-}" ]] || { echo "ERROR: package mode requires a feed path" >&2; return 1; }
    build_feed_index "${cli_build_args[1]}"
    return 0
  fi

  build_items=("${cli_build_args[@]}")

  for i in "${!build_items[@]}"; do
    for f in "${folders[@]}"; do
      if [[ -d "$f/${build_items[$i]}" ]]; then
        build_items[i]="$f/${build_items[$i]}"
        found=1
        break
      fi
    done
    (( found == 1 )) || { echo "invalid package:${build_items[$i]}" >&2; return 1; }
    found=0
  done
}

register_feed_targets() {
  local pkg
  local name
  local feed_name

  for pkg in "${build_items[@]}"; do
    name="$(basename "$pkg")"
    feed_name="$(feed_name_for_package "$name")"
    update_feeds["$feed_name"]="$(feed_path_for_name "$feed_name")"
  done

  local feed
  for feed in "${!update_feeds[@]}"; do
    mkdir -p "${update_feeds[$feed]}"
  done
}

# args: ${1} [in] build path (../.build)
#       ${2} in source path (../addons/project-name)
#       ${3} [out] develop path (../.build/project-name)
develop_source_byref() {
  local build_path="${1}"
  local src_path="${2}"
  local rel_src_path
  local dest_path
  local -n _develop_path="${3}"
  local -a options=()

  if [[ "$src_path" =~ ^(\.\./)+(.*)$ ]]; then
    rel_src_path="${BASH_REMATCH[2]}"
  else
    # Keep source layout under the build path when source is not ../-prefixed.
    rel_src_path="${src_path#./}"
    rel_src_path="${rel_src_path#/}"
  fi

  [[ -n "$rel_src_path" ]] || {
    echo "ERROR: invalid source path: $src_path" >&2
    return 1
  }

  dest_path="$build_path/$rel_src_path"

  options=(--exclude=*.bak --exclude=.git --exclude=*.tmp --exclude=tests/)
  options+=(--exclude=*.old --exclude=.venv/ --exclude='__pycache__/')

  # Exclude directories containing .opkg-ignore
  while IFS= read -r rel_dir; do
    options+=(--exclude="$rel_dir/")
  done < <(
    find "$src_path" -type f -name ".opkg-ignore" | sed "s|^$src_path/||" |
    xargs -r -n1 dirname
  )

  # `-a` enables archive mode (recursive copy and preserve symlinks).
  # Keep links intact so runtime absolute links can be packaged even if referent
  # paths do not exist on the build host.
  # `--mkpath` creates the destination path if it does not already exist.
  # `--delete` keeps the cached staging dir in sync with the source tree.
  echo "  rsync staging: ${src_path} -> ${dest_path}"
  /usr/bin/time -f "  rsync elapsed: %E (user=%U sys=%S cpu=%P)" rsync -a --delete --mkpath "$src_path/" "$dest_path" "${options[@]}" || return 1
  _develop_path="$dest_path"

  return 0
}

# Appends a develop build stamp (~dYYMMDD.HHMM) to the Version field in
# the copied CONTROL/control file. Never touches the source control file.
stamp_develop_version() {
  local develop_path="${1}"
  local control_file="${develop_path}/CONTROL/control"
  local stamp

  [[ -f "$control_file" ]] || { echo "ERROR: control file not found: $control_file" >&2; return 1; }

  #stamp="~d$(date -u +'%y%m%d.%H%M')"
	stamp="~d$(date +'%y%m%d.%H%M')"

	sed -i "s/^\(Version:.*\)$/\1${stamp}/" "$control_file"
}

build_package() {

  local pkg_root="${1}"
  local run_build_all="${2:-1}"
  local path="${pkg_root}/src"
  local name; name="$(basename "${pkg_root}")"
  local feed_name
  local feed_path
  local feed_path_abs

  feed_name="$(feed_name_for_package "$name")"
  feed_path="$(feed_path_for_name "$feed_name")"
  mkdir -p "$feed_path"
  feed_path_abs="$(cd "$feed_path" && pwd)"

	local build_path="../.build/${name}"

  echo -e "\e[32mbuilding ${name} -> ${feed_path_abs}\e[0m"

	if [[ -f "${pkg_root}/src-external/build-external" ]]; then
    if (( all_mode == 0 )) || [[ "$run_build_all" == "1" ]]; then
      echo "  executing ${pkg_root}/src-external/build-external" "$build_path"
      "${pkg_root}/src-external/build-external" 3>&1 1>/dev/null || return 1
    fi
	fi

  [[ -d "${path}" ]] || { echo "invalid path: ${path}" >&2 ; return 1; }

  local develop_path;
  develop_source_byref "$build_path" "$path" develop_path || return 1

  if (( develop_only == 1 )); then
    stamp_develop_version "$develop_path" || return 1
    # Remove superseded develop packages for this package before placing the new one
    find "$feed_path_abs" -maxdepth 1 -name "${name}_*.ipk" -exec rm -f {} +
  fi

  mkdir -p "${develop_path}/data/apps/available/${name}"
  # shellcheck disable=SC2005
  # echo "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" > "${develop_path}/data/apps/${name}/buildtime"
  echo "$(date)" > "${develop_path}/data/apps/available/${name}/buildtime"

  opkg-build -o root -g root "${develop_path}/" "${feed_path_abs}"

}

promote_feed() {
  local feed_name="$1"
  local src_path="${develop_root}/${feed_name}"
  local dst_path="${release_root}/${feed_name}"

  [[ -d "$src_path" ]] || { echo "ERROR: develop feed not found: ${src_path}" >&2; return 1; }

  mkdir -p "$dst_path"
  rsync -a --delete "$src_path/" "$dst_path/"

  echo "promoted ${feed_name} feed"
}
function create_latest_feed_package() {
	local feed="${1}"
	local feed_path="${feeds_root}/${feed}/vespera"
  local newest_vespera_ipk
  newest_vespera_ipk="$(find "$feed_path" -type f -name 'vespera*.ipk' -printf '%T@ %p\n' | sort -nr | head -n1 | cut -d' ' -f2-)"

  if [ -n "$newest_vespera_ipk" ]; then
			local latest_copy_path="${feed_path}/../vespera-latest.ipk"
      cp -f "$newest_vespera_ipk" "$latest_copy_path"
			echo "Created latest package : ${latest_copy_path}"
	else
			echo "No vespera*.ipk package found under ${feed_path}"
	fi
}
promote_release() {
  local feed_name
  local -a feeds_to_promote=()

  if [[ -n "$promote_target" ]]; then
    [[ "$promote_target" == "$test_feed_name" ]] && {
      echo "ERROR: ${test_feed_name} is a flat custom test feed and is not promotable" >&2
      return 1
    }

    [[ "$promote_target" == "addons" || "$promote_target" == "vespera" ]] || {
      echo "ERROR: invalid promote feed: ${promote_target}" >&2
      return 1
    }
    [[ -d "${develop_root}/${promote_target}" ]] && feeds_to_promote+=("$promote_target")
  elif [[ ${#update_feeds[@]} -gt 0 ]]; then
    for feed_name in "${!update_feeds[@]}"; do
      [[ "$feed_name" == "$test_feed_name" ]] && continue
      feeds_to_promote+=("$feed_name")
    done
  else
    for feed_name in "addons" "vespera"; do
      [[ -d "${develop_root}/${feed_name}" ]] && feeds_to_promote+=("$feed_name")
    done
  fi

  [[ ${#feeds_to_promote[@]} -gt 0 ]] || { echo "ERROR: no develop feeds available to promote" >&2; return 1; }

  for feed_name in "${feeds_to_promote[@]}"; do
    promote_feed "$feed_name"
  done
}

clean_develop_root() {
  [[ -d "$develop_root" ]] || { mkdir -p "$develop_root"; return 0; }

  find "$develop_root" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  mkdir -p "$develop_root"
  echo "cleaned develop feeds folder: ${develop_root}"
}


if (( clean_develop_only == 1 )); then
  clean_develop_root
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

if (( promote_only == 1 )); then
  if [[ ${#cli_build_args[@]} -gt 0 ]]; then
    promote_target="${cli_build_args[0]}"
    [[ "$promote_target" == "all" ]] && promote_target=
  fi
  promote_release
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

resolve_build_items

if [[ ${#cli_build_args[@]} -gt 0 && "${cli_build_args[0]}" == "package" ]]; then
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

register_feed_targets

declare -a build_pids=()
declare -i build_failed=0
declare -i wait_status=0
declare built_items_file
built_items_file="$(mktemp)"
trap 'rm -f "$built_items_file"' EXIT

for pkg in "${build_items[@]}"; do
  (
    build_package_if_needed "$pkg" || exit $?
    echo "$pkg" >> "$built_items_file"
  ) &
  build_pids+=("$!")
done

for pid in "${build_pids[@]}"; do
  if wait "$pid"; then
    :
  else
    wait_status=$?
    if (( wait_status != 10 )); then
      build_failed=1
    fi
  fi
done

(( build_failed == 0 )) || { echo "One or more package builds failed" >&2; exit 1; }

mapfile -t build_items < "$built_items_file"

if [[ ${#build_items[@]} -eq 0 ]]; then
  echo "nothing to build"
  cd "$pwd_old" || true
  echo "Completed"
  exit 0
fi

update_feeds=()
register_feed_targets

build_feed_indexes

if (( develop_only == 0 )); then
  promote_release
fi

if ((develop_only == 1)); then
	if echo "${build_items[@]}" | grep -q "vespera"; then
	  #NOTE not part of feed indexes, this is a direct opkg download.
		create_latest_feed_package develop
	fi
fi

cd "$pwd_old" || true
echo "Completed"
